        // --- НАЧАЛО НА ПРОМЯНАТА (3/5): Координаторът управлява състоянието ---
        var currentFilter: CalendarFilterType = .all
        // --- КРАЙ НА ПРОМЯНАТА (3/5) ---

        init(_ parent: TwoWayPinnedSingleDayMultiCalendarWrapper) {
            self.parent = parent
            super.init()

