            guard let ghostView = ghostEmptySpaceView else { return }
            ghostView.layer.setValue(nil, forKey: DRAG_DATA_KEY)

            let finalFrame = ghostView.frame
            let topPoint = CGPoint(x: finalFrame.midX, y: finalFrame.minY)
