                    guard let profile = try container.mainContext.fetch(descriptor).first else {
                        print("📲 [AppIntent] ❌ Profile '\(profileName)' not found.")
                        return
                    }

                    let planner = USDAWeeklyMealPlanner(context: container.mainContext)
                    planner.onLog = { print("[AppIntent] \($0)") }
                    // --- START OF CHANGE: Pass nil for specificMeals to use default behavior ---
