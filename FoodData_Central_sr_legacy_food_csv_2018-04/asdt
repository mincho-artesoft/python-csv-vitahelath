import UserNotifications

extension UNUserNotificationCenter: @unchecked @retroactive Sendable {}
extension UNNotificationSettings: @unchecked @retroactive Sendable {}

@MainActor
class NotificationManager {
    static let shared = NotificationManager()
    private init() {}

    func requestAuthorization() async -> Bool {
        do {
            let granted = try await UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .badge, .sound])
            print("Разрешението за нотификации е: \(granted)")
            return granted
        } catch {
            print("Грешка при искане на разрешение: \(error.localizedDescription)")
            return false
        }
    }
    
    func getAuthorizationStatus() async -> UNAuthorizationStatus {
        let settings = await UNUserNotificationCenter.current().notificationSettings()
        return settings.authorizationStatus
    }

    // --- НАЧАЛО НА КОРЕКЦИЯТА ---
    // Променяме типа на userInfo от [String: Any] на [String: Sendable].
    // Това казва на компилатора, че всички стойности в речника са безопасни за конкурентна среда.
    // Типове като String, Int, Double, Bool и UUID са Sendable по подразбиране.
    func scheduleNotification(title: String, body: String, timeInterval: TimeInterval, userInfo: [String: Sendable]) async throws -> String {
    // --- КРАЙ НА КОРЕКЦИЯТА ---
        
        let content = UNMutableNotificationContent()
        content.title = title
        content.body = body
        content.sound = .default
        
        // userInfo вече е от безопасен тип, така че това присвояване е наред.
        content.userInfo = userInfo

        let trigger = UNTimeIntervalNotificationTrigger(timeInterval: timeInterval, repeats: false)
        let id = UUID().uuidString
        
        // Създаваме заявката с променимото съдържание.
        // Забележка: Решението с .copy() също е валидно, но промяната на типа на userInfo е по-фундаментална.
        // Можете да оставите и .copy() за допълнителна сигурност, ако желаете.
        let request = UNNotificationRequest(identifier: id, content: content.copy() as! UNNotificationContent, trigger: trigger)

        // Сега тази линия вече няма да дава предупреждение, защото userInfo е Sendable.
        try await UNUserNotificationCenter.current().add(request)
        
        print("Нотификация с ID: \(id) е успешно планирана.")
        
        return id
    }

    func cancelNotification(id: String) {
        UNUserNotificationCenter.current().removePendingNotificationRequests(withIdentifiers: [id])
        print("Нотификация с ID: \(id) е отменена.")
    }
}


