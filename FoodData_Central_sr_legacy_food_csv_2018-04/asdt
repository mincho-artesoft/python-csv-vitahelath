        v.backgroundColor = accentColor.withAlphaComponent(0.2)

        self.addSubview(v)
        self.sendSubviewToBack(v)
        
        lineView = v
    }
    
    /// Чертай кръг зад датата (selectedColor)
    func addCircle() {
