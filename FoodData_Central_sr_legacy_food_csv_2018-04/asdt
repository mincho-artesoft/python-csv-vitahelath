// MARK: - Deterministic RNG for variety across users/weeks
fileprivate struct LCG: RandomNumberGenerator {
    fileprivate var state: UInt64
    init(seed: UInt64) { self.state = seed &+ 0x9E3779B97F4A7C15 }
    mutating func next() -> UInt64 {
        state = 6364136223846793005 &* state &+ 1
        return state
    }
}

fileprivate func makeSeed(profile: Profile, startDate: Date) -> UInt64 {
    let dayOrd = UInt64(Calendar.current.ordinality(of: .day, in: .era, for: startDate) ?? 0)
    let nameHash = UInt64(bitPattern: Int64(profile.name.hashValue))
    let weightBits = UInt64(profile.weight.rounded())
    let heightBits = UInt64(profile.height.rounded())
    return dayOrd ^ (nameHash &* 0x9E3779B97F4A7C15) ^ (weightBits << 21) ^ (heightBits << 5)
}

fileprivate extension Array where Element == (food: FoodItem, score: Double) {
    func weightedRandom(using rng: inout LCG) -> FoodItem? {
        guard !isEmpty else { return nil }
        let topN = Swift.min(6, count)
        let slice = self[0..<topN]
        let total = slice.reduce(0.0) { $0 + Swift.max(0.0001, $1.score) }
        var r = Double(rng.next() % UInt64.max) / Double(UInt64.max) * total
        for pair in slice {
            r -= Swift.max(0.0001, pair.score)
            if r <= 0 { return pair.food }
        }
        return slice.last?.food
    }
}

fileprivate extension Array {
    mutating func shuffle(using rng: inout LCG) {
        if count < 2 { return }
        for i in stride(from: count - 1, through: 1, by: -1) {
            let j = Int(rng.next() % UInt64(i + 1))
            if i != j { self.swapAt(i, j) }
        }
    }
    func shuffled(using rng: inout LCG) -> [Element] {
        var copy = self
        copy.shuffle(using: &rng)
        return copy
    }
}

