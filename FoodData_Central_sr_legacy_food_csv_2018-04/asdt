                  await saveMealsToCalendar()
              } catch {
                  print("Autosave task cancelled.")
              }
          }
      }

      private func selectClosestMealToNow() {
          let nowSec = secs(Date())
          if let m = dailyMeals.min(by: {
              abs(secs($0.startTime) - nowSec) < abs(secs($1.startTime) - nowSec)
          }) {
              selectedMealID = m.id
          } else {
              selectedMealID = nil
          }
      }

