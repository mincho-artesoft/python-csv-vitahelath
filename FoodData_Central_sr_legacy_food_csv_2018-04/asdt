            print("📲 [AppIntent] Found pending request to generate meal plan for '\(profileName)'.")
            
            defaults.removeObject(forKey: GenerateUSDAWeeklyMealPlanIntent.userDefaultsKey)

            Task(priority: .userInitiated) {
