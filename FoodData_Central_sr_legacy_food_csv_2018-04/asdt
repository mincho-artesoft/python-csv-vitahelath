                    .filter { $0 == true }
                    .first()
                    .sink { _ in
                        let descriptor = FetchDescriptor<ShoppingListModel>(predicate: #Predicate { $0.id == listID })
                        if let list = try? modelContext.fetch(descriptor).first {
                            present(list: list)
                            coordinator.pendingShoppingListID = nil
                        } else {
