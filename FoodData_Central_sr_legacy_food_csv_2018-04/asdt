    // --- НАЧАЛО НА ПРОМЯНАТА (3/4): Добавяме изчисляемо свойство за текста ---
    private var balanceText: String {
        if netCalorieBalance > 0 {
            return String(format: "+%.0f", netCalorieBalance)
        } else if netCalorieBalance < 0 {
            return String(format: "%.0f", netCalorieBalance)
        } else {
