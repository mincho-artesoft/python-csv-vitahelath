 find . -type f \( -name "*.swift" -o -name "*.metal" \) | while IFS= read -r file; do
  fullpath=$(realpath -- "$file")
  {
    printf '==== FILE: %s ====\n' "$fullpath"
    cat -- "$file"
    printf '\n\n'
  } >> merged_output.txt
done

find . -type d \( -name Analytics -o -name Subscriptions -o -name Storage -o -name Exercise -o -name TrainingPlan -o -name Fitness -o -name ShoppingList -o -name Settings -o -name Pods -o -name build -o -name node_modules -o -name .git \) -prune -o \
       -type f \( -name '*.swift' -o -name '*.metal' \) -print0 |
while IFS= read -r -d '' file; do
  fullpath=$(realpath "$file")
  {
    printf '==== FILE: %s ====\n' "$fullpath"
    cat -- "$file"
    printf '\n\n'
  } >> merged_output.txt
done
