        let defaultQuantity = isImperial ? UnitConversion.ozToG(4.0) : 100.0
        let defaultPrice = lastPrices[food.id]
        withAnimation { editableItems.insert(EditableShoppingListItem(from: food, quantity: defaultQuantity, price: defaultPrice), at: 0) }
