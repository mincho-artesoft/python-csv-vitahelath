                                        // Бутон за изтриване на тема
                                        Button(role: .destructive) {
                                            withAnimation { themeManager.deleteCustomTheme(themeToDelete: theme) }
                                        } label: {
                                            Label("Delete", systemImage: "trash")
                                        }
