    private func handleAIGenerationTap() {
        guard let profile = selectedProfile else { return }
        
        var contextToSet: AIGenerationContext? = nil
        
        if isProfilesDrawerVisible {
            contextToSet = .weeklyPlan(profile: profile)
        } else {
            switch selectedTab {
            case .nutrition:
                contextToSet = .dailyMeals(profile: profile, date: nutritionChosenDate)
            case .foods:
                switch foodListVM.filter {
                case .plans:
                    contextToSet = .weeklyPlan(profile: profile)
                case .recipes:
                    contextToSet = .recipe
                case .menus:
                    contextToSet = .menu
                default:
                    contextToSet = .recipe
                }
            case .exercises:
                contextToSet = .weeklyPlan(profile: profile)
            default:
                contextToSet = .weeklyPlan(profile: profile)
            }
        }

        guard let finalContext = contextToSet else { return }
        
        self.aiGenerationContext = finalContext
        
        withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
            isShowingAIGenerationMenu = true
            aiGenerationMenuState = .full
            navBarIsHiden = true
            if isSearching {
                dismissSearch()
            }
        }
    }
    
