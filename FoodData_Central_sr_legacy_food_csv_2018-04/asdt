 find . -type f \( -name "*.swift" -o -name "*.metal" \) | while IFS= read -r file; do
  fullpath=$(realpath -- "$file")
  {
    printf '==== FILE: %s ====\n' "$fullpath"
    cat -- "$file"
    printf '\n\n'
  } >> merged_output.txt
done

