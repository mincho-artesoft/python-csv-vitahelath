    private func goalProgress(on date: Date) -> Double? {
        let k = key(for: date)
        if let ready = dayProgress[k] { return ready }
        
        Task {
            if let fresh = await computeProgress(for: date, profile: self.profile) {
                       await MainActor.run { dayProgress[k] = fresh
                }
            }
        }
