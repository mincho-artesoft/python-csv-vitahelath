    private func generatePlan() {
        generationTask?.cancel()
        withAnimation(.easeInOut) {
            isGenerating = true
            generatedDays = [:]
            prompt = nil
            planStartDate = Date()
        }
        
        generationTask = Task {
            let planner = USDAWeeklyMealPlanner(context: modelContext)
            planner.onLog = { print("[AIPlanGenView] \($0)") }
            
            do {
                let orderedMeals = profile.meals
                    .sorted { $0.startTime < $1.startTime }
                    .map { $0.name }
                    .filter { selectedMealNames.contains($0) }
                let specificMealsArg: [String]? = orderedMeals.isEmpty ? nil : orderedMeals

                let stream = try planner.simulateWeek(
                    for: profile,
                    startDate: planStartDate,
                    numberOfDays: numberOfDays,
                    specificMeals: specificMealsArg
                )
                for try await update in stream {
                    if Task.isCancelled { break }
                    withAnimation(.spring()) {
                        switch update {
                        case .prompt(let p):
                            self.prompt = p
                        case .meal(let dayIndex, let meal):
                            generatedDays[dayIndex, default: []].append(meal)
                        }
                    }
                }
                if !Task.isCancelled {
                    withAnimation { isGenerating = false }
                }
            } catch {
                if Task.isCancelled { return }
                self.alertMessage = "Failed to generate a plan: \(error.localizedDescription)"
                withAnimation {
                    self.isGenerating = false
                    self.isShowingAlert = true
                }
            }
        }
    }

    private func cancelGeneration() {
        generationTask?.cancel()
        withAnimation {
            isGenerating = false
        }
    }
    
    private func saveGeneratedPlan() {
        guard !generatedDays.isEmpty else { return }
        
        let previewDays = generatedDays.keys.sorted().compactMap { dayIndex -> MealPlanPreviewDay? in
            guard let meals = generatedDays[dayIndex] else { return nil }
            return MealPlanPreviewDay(dayIndex: dayIndex, meals: meals)
        }
        let preview = MealPlanPreview(
            startDate: self.planStartDate,
            prompt: self.prompt ?? "No prompt available",
            days: previewDays
        )
        
        isGenerating = true
        
        generationTask = Task {
            let planner = USDAWeeklyMealPlanner(context: modelContext)
            planner.onLog = { print("[AIPlanGenView] \($0)") }
            
            do {
                _ = try planner.savePlan(from: preview, for: profile)
                if Task.isCancelled { return }
                withAnimation { isGenerating = false }
                onDismiss()
            } catch {
                if Task.isCancelled { return }
                self.alertMessage = "Failed to save the plan: \(error.localizedDescription)"
                withAnimation {
                    self.isGenerating = false
                    self.isShowingAlert = true
                }
            }
        }
    }
