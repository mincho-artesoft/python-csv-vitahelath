                            .foregroundColor(effectManager.currentGlobalAccentColor.opacity(0.8))
                    }
                    nutrientChips()
                }
                .layoutPriority(1)
            }
        }
        
    }

    // MARK: - Sub-helpers
    @ViewBuilder
    private func weightAndCaloriesText() -> some View {
        let displayWeight = UnitConversion.formatGramsToFoodDisplay(totalWeightG)
