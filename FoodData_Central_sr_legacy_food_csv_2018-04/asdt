    private var mainContent: some View {
        VStack(spacing: 0) {
            customToolbar
                .padding(.horizontal)

            if displayItems.isEmpty && globalSearchText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
                ContentUnavailableView {
