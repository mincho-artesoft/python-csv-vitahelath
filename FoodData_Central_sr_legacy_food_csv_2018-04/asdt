        let groupingSeparator = locale.groupingSeparator ?? ","
        let decimalSeparator = locale.decimalSeparator ?? "."
        
        let noGrouping = input.replacingOccurrences(of: groupingSeparator, with: "")
        
        let parser = NumberFormatter()
        parser.decimalSeparator = decimalSeparator
        
        return parser.number(from: noGrouping)?.doubleValue
    }
      
    static func integerAsDouble(from input: String) -> Double? {
         return integer(from: input).map(Double.init)
    }

