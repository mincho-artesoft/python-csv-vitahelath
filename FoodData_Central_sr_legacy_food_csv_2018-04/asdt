// WiseEating/Food/SeedManager.swift

import SwiftData
import Foundation
import UIKit // ВАЖНО: Добавете UIKit за достъп до UIImage

@MainActor
enum SeedManager {

    // MARK: – Public entry point
    static func seedIfNeeded(container: ModelContainer) async {
        print("🚀 Starting database seed process if needed...")
        let ctx = GlobalState.modelContext!
        ctx.autosaveEnabled = false

        await seedReferenceVitaminsIfNeeded(context: ctx)
        await seedReferenceMineralsIfNeeded(context: ctx)
        await seedReferenceDietsIfNeeded(context: ctx)
        await seedFoodsIfNeeded(context: ctx)
        await seedExercisesIfNeeded(context: ctx)
        await seedNutrientIndexesIfNeeded(context: ctx)
        await seedNameIndexIfNeeded(context: ctx)

        do {
            if ctx.hasChanges {
                try ctx.save()
                print("💾 Final save of all seeded data successful.")
            }
        } catch {
            print("❌ Final save after seeding failed: \(error)")
        }

        print("✅ Seeding process completed.")
    }

    // MARK: – Foods ----------------------------------------------------------
    private static func seedFoodsIfNeeded(context ctx: ModelContext) async {
        print("-> Checking for Foods...")
        guard databaseIsEmpty(entity: FoodItem.self, context: ctx) else {
            print("   Foods already seeded, skipping.")
            return
        }

        print("   Seeding Foods from foods.json...")
        guard let url = Bundle.main.url(forResource: "foods", withExtension: "json") else {
            assertionFailure("foods.json not found"); return
        }

        do {
            // Вземаме управляваните Diet обекти от базата данни
            let persistedDiets = try ctx.fetch(FetchDescriptor<Diet>())
            let dietMap: [String: Diet] = Dictionary(
                uniqueKeysWithValues: persistedDiets.map {
                    ($0.name.trimmingCharacters(in: .whitespacesAndNewlines).lowercased(), $0)
                }
            )
            print("   - Loaded \(dietMap.count) persisted diets from store for linking.")

            // Зареждане на JSON и декодиране
            let raw = try Data(contentsOf: url)
            let dtos = try JSONDecoder().decode([FoodItemDTO].self, from: raw)
            print("   - Decoded \(dtos.count) food DTOs from JSON.")

            // Създаване на моделите и инсърт
            var items: [FoodItem] = []
            items.reserveCapacity(dtos.count)

            for dto in dtos {
                let model = dto.model(dietMap: dietMap)
                model.isUserAdded = false
                model.isRecipe = false
                items.append(model)
            }

            try ctx.transaction {
                for item in items { ctx.insert(item) }
            }
            print("   ✅ Seeded \(items.count) foods with their diet relationships.")
        } catch {
            print("   ❌ Food seeding failed: \(error)")
        }
    }
    
    // MARK: – Exercises ------------------------------------------------------
    private static func seedExercisesIfNeeded(context ctx: ModelContext) async {
          print("-> Checking for Exercises...")
          guard databaseIsEmpty(entity: ExerciseItem.self, context: ctx) else {
              print("   Exercises already seeded, skipping.")
              return
          }

          print("   Seeding default Exercises...")
          do {
              try ctx.transaction {
                  for exerciseTemplate in defaultExercisesList {
                      let newExercise = ExerciseItem(
                          id: exerciseTemplate.id,
                          name: exerciseTemplate.name,
                          sports: exerciseTemplate.sports,
                          description: exerciseTemplate.exerciseDescription,
                          videoURL: exerciseTemplate.videoURL,
                          metValue: exerciseTemplate.metValue,
                          isUserAdded: false,
                          assetImageName: exerciseTemplate.assetImageName,
                          muscleGroups: exerciseTemplate.muscleGroups,
                          durationMinutes: exerciseTemplate.durationMinutes
                      )
                      
                      if let assetName = exerciseTemplate.assetImageName {
                          if let image = UIImage(named: assetName) {
                              newExercise.photo = image.jpegData(compressionQuality: 0.8)
                          } else {
//                              print("   ⚠️ WARNING: Asset '\(assetName)' not found for exercise '\(newExercise.name)'")
                          }
                      }
                      
                      ctx.insert(newExercise)
                  }
              }
              print("   ✅ Seeded \(defaultExercisesList.count) exercises with images.")
              
              // --- START OF MODIFICATION ---
              // 1. Fetch all seeded exercises to perform counts
              let allSeededExercises = try ctx.fetch(FetchDescriptor<ExerciseItem>())

              // 2. Count exercises per sport
              var sportCounts: [Sport: Int] = Dictionary(uniqueKeysWithValues: Sport.allCases.map { ($0, 0) })
              for exercise in allSeededExercises {
                  if let sports = exercise.sports {
                      for sport in sports {
                          sportCounts[sport, default: 0] += 1
                      }
                  }
              }

              print("   📊 Exercise count per sport after seeding:")
              for (sport, count) in sportCounts.sorted(by: { $0.key.rawValue < $1.key.rawValue }) {
                  print("      - \(sport.rawValue): \(count) exercises")
              }

              // 3. Count exercises per muscle group
              var muscleCounts: [MuscleGroup: Int] = Dictionary(uniqueKeysWithValues: MuscleGroup.allCases.map { ($0, 0) })
              for exercise in allSeededExercises {
                  for muscle in exercise.muscleGroups {
                      muscleCounts[muscle, default: 0] += 1
                  }
              }

              print("   💪 Exercise count per muscle group after seeding:")
              for (muscle, count) in muscleCounts.sorted(by: { $0.key.rawValue < $1.key.rawValue }) {
                  print("      - \(muscle.rawValue): \(count) exercises")
              }
              
              // --- START OF NEW ADDITION ---
              // 4. Print sports with fewer than 7 exercises
              print("   ⚠️ Sports with fewer than 7 exercises:")
              let underrepresentedSports = sportCounts.filter { $0.value > 0 && $0.value < 7 }.sorted(by: { $0.key.rawValue < $1.key.rawValue })
              
              if underrepresentedSports.isEmpty {
                  print("      - None. All relevant sports have 7 or more exercises.")
              } else {
                  for (sport, count) in underrepresentedSports {
                      print("      - \(sport.rawValue): \(count) exercises")
                  }
              }
              // --- END OF NEW ADDITION ---

          } catch {
              print("   ❌ Exercise seeding failed: \(error)")
          }
      }

    // MARK: – Reference Vitamins --------------------------------------------
    private static func seedReferenceVitaminsIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: Vitamin.self, context: ctx) else {
            return
        }
        do {
            try ctx.transaction {
                for vitamin in defaultVitaminsList {
                    ctx.insert(vitamin)
                }
            }
            print("   ✅ Seeded \(defaultVitaminsList.count) vitamins.")
        } catch {
            print("   ❌ Vitamin seeding failed: \(error)")
        }
    }

    // MARK: – Reference Minerals --------------------------------------------
    private static func seedReferenceMineralsIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: Mineral.self, context: ctx) else {
            return
        }
        do {
            try ctx.transaction {
                for mineral in defaultMineralsList {
                    ctx.insert(mineral)
                }
            }
            print("   ✅ Seeded \(defaultMineralsList.count) minerals.")
        } catch {
            print("   ❌ Mineral seeding failed: \(error)")
        }
    }

    // MARK: – Reference Diets
    private static func seedReferenceDietsIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: Diet.self, context: ctx) else {
            return
        }
        do {
            try ctx.transaction {
                for diet in defaultDietsList {
                    ctx.insert(diet)
                }
            }
            print("   ✅ Seeded \(defaultDietsList.count) diets.")
        } catch {
            print("   ❌ Diet seeding failed: \(error)")
        }
    }

    // MARK: - Nutrient Indexes ----------------------------------------------
    private static func seedNutrientIndexesIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: NutrientIndex.self, context: ctx) else {
            return
        }

        do {
            let vitamins = try ctx.fetch(FetchDescriptor<Vitamin>())
            let minerals = try ctx.fetch(FetchDescriptor<Mineral>())
            let allNutrientIDs = vitamins.map { "vit_\($0.id)" } + minerals.map { "min_\($0.id)" }

            let allFoods = try ctx.fetch(FetchDescriptor<FoodItem>())

            for nutrientID in allNutrientIDs {
                var rankings: [FoodRank] = []
                rankings.reserveCapacity(max(8, allFoods.count / 10))

                for food in allFoods {
                    if let (value, unit) = food.value(of: nutrientID), value > 0 {
                        let valueInMg = toMg(value: value, unit: unit)
                        rankings.append(.init(
                            foodID: food.id,
                            value: valueInMg,
                            nameKey: food.nameNormalized
                        ))
                    }
                }

                if rankings.isEmpty { continue }
                rankings.sort { $0.value > $1.value }

                let index = NutrientIndex(nutrientID: nutrientID, rankedFoods: rankings)
                ctx.insert(index)
            }

            print("   ✅ Seeded \(allNutrientIDs.count) nutrient indexes.")
        } catch {
            print("   ❌ Nutrient index seeding failed: \(error)")
        }
    }

    // MARK: - Name Index
    private static func seedNameIndexIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: NameIndex.self, context: ctx) else {
            return
        }
        do {
            let allFoods = try ctx.fetch(FetchDescriptor<FoodItem>())
            let entries: [NameEntry] = allFoods.map { .init(foodID: $0.id, nameKey: $0.nameNormalized) }
            let ix = NameIndex(entries: entries)
            ctx.insert(ix)
            print("   ✅ Seeded name index with \(entries.count) entries.")
        } catch {
            print("   ❌ Name index seeding failed: \(error)")
        }
    }

    // MARK: – Helper
    private static func databaseIsEmpty<T: PersistentModel>(
        entity: T.Type,
        context ctx: ModelContext
    ) -> Bool {
        ((try? ctx.fetchCount(FetchDescriptor<T>())) ?? 0) == 0
    }

    private static func toMg(value: Double, unit: String) -> Double {
        switch unit.lowercased() {
        case "g":            return value * 1_000
        case "µg", "mcg":    return value * 0.001
        default:             return value
        }
    }
}


