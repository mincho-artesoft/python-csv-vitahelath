    private func validateMinAgeOnBlur() {
        let currentUserAge = Int(minAgeMonthsTxt) ?? 0
        if currentUserAge < calculatedMinAge {
            minAgeMonthsTxt = String(calculatedMinAge)
        }
    }
    
