import SwiftUI
import UIKit

struct CustomSegmentedControl: UIViewRepresentable {
    
    // Входни данни за контрола
    var items: [String]
    @Binding var selection: Int
    var accentColor: Color

    // Тази функция създава UIKit View-то за първи път.
    func makeUIView(context: Context) -> UISegmentedControl {
        let control = UISegmentedControl(items: items)
        
        // --- НАЧАЛО НА КОРЕКЦИЯТА ---
        // Казваме на контрола да не се "противопоставя", когато SwiftUI се опитва
        // да го компресира хоризонтално. Това решава проблема с излизането от екрана.
        control.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
        // --- КРАЙ НА КОРЕКЦИЯТА ---
        
        // Свързваме Coordinator-а, за да обработваме натисканията на потребителя
        control.addTarget(
            context.coordinator,
            action: #selector(Coordinator.updateSelection(sender:)),
            for: .valueChanged
        )
        
        return control
    }

    func updateUIView(_ uiView: UISegmentedControl, context: Context) {
        // Уверяваме се, че избраният сегмент е актуален
        uiView.selectedSegmentIndex = selection
        
        // Преобразуваме SwiftUI Color в UIColor
        let uiColor = UIColor(accentColor)
        
        // Прилагаме стиловете
        uiView.setTitleTextAttributes([.foregroundColor: uiColor], for: .normal)
        uiView.setTitleTextAttributes([.foregroundColor: uiColor], for: .selected)
        uiView.backgroundColor = .clear
        uiView.selectedSegmentTintColor = uiColor.withAlphaComponent(0.2)
        
        // Предпазваме от crash при първоначалното зареждане
        guard uiView.bounds.height > 0 else {
            return
        }
        
        // Създаваме прозрачно изображение, за да премахнем разделителите
        let transparentImage = UIImage.createTransparentImage(with: CGSize(width: 1, height: uiView.bounds.height))
        
        // Поставяме го като разделител между сегментите за всички състояния.
        uiView.setDividerImage(transparentImage, forLeftSegmentState: .normal, rightSegmentState: .normal, barMetrics: .default)
        uiView.setDividerImage(transparentImage, forLeftSegmentState: .selected, rightSegmentState: .normal, barMetrics: .default)
        uiView.setDividerImage(transparentImage, forLeftSegmentState: .normal, rightSegmentState: .selected, barMetrics: .default)
    }

    func makeCoordinator() -> Coordinator {
        Coordinator(self)
    }
    
    class Coordinator: NSObject {
        var parent: CustomSegmentedControl
        
        init(_ parent: CustomSegmentedControl) {
            self.parent = parent
        }
        
        @MainActor @objc func updateSelection(sender: UISegmentedControl) {
            parent.selection = sender.selectedSegmentIndex
        }
    }
}

// Помощно разширение за UIImage за създаване на прозрачно изображение
extension UIImage {
    static func createTransparentImage(with size: CGSize) -> UIImage {
        let renderer = UIGraphicsImageRenderer(size: size)
        return renderer.image { context in
            // Контекстът е прозрачен по подразбиране
        }
    }
}


