            if fat     > 0 { segments.append(.init(name: "Fat",     value: fat,     color: Color(hex: "FFE5CC"))) }
            if carbs   > 0 { segments.append(.init(name: "Carbs",   value: carbs,   color: Color(hex: "D6ECFF"))) }
