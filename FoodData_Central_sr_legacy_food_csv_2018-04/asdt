// Файл: ConfigurableTextField.swift

import SwiftUI

/// Един универсален, преизползваем TextField, който може да бъде конфигуриран
/// да се държи като поле за стандартен, целочислен или десетичен вход.
struct ConfigurableTextField<Field: Hashable>: View {
    @ObservedObject private var effectManager = EffectManager.shared

    // MARK: - Configuration Enum
    enum FieldType {
        case standard
        case integer
        case decimal
    }

    // MARK: - Properties
    let title: String
    @Binding var value: String
    let type: FieldType
    let placeholderColor: Color? // <-- НОВ ПАРАМЕТЪР
    var isLanding = false
    // Опционални параметри за интеграция с FocusState.
    var focused: FocusState<Field?>.Binding?
    var fieldIdentifier: Field?
    var onFocus: (() -> Void)?
   

    // MARK: - Body
    var body: some View {
        // ----- 👇 НАЧАЛО НА ПРОМЯНАТА -----
        // Използваме ZStack, за да можем да сложим наш собствен плейсхолдър
        // върху истинския TextField.
        ZStack {
            // 1. Показваме нашия персонализиран плейсхолдър (Text) само ако стойността е празна.
            // Можем да му зададем какъвто цвят искаме.
            if value.isEmpty {
                // Тъй като полето в ShoppingItemEditableField е с дясна подравнка,
                // използваме HStack със Spacer, за да позиционираме плейсхолдъра правилно.
                HStack {
                    if isLanding {
                        Text(title)
                            .foregroundColor(placeholderColor ?? effectManager.currentGlobalAccentColor.opacity(0.6))
                        
                        Spacer()

                    }else{
                        Spacer()
                        
                        Text(title)
                            .foregroundColor(placeholderColor ?? effectManager.currentGlobalAccentColor.opacity(0.6)) // Използваме новия цвят
                    }
                }
                .allowsHitTesting(false) // Правим го "прозрачен" за докосвания
            }

            // 2. Истинският TextField вече има празен плейсхолдър (""),
            // защото нашият Text го замества.
            let textField = TextField("", text: $value)
                .keyboardType(keyboardType)
                .disableAutocorrection(true)
                .autocapitalization(.none)
                .textInputAutocapitalization(.never)
                .onChange(of: value, handleValidation)

            if let focused = focused, let fieldIdentifier = fieldIdentifier {
                textField
                    .focused(focused, equals: fieldIdentifier)
                    .onChange(of: focused.wrappedValue) { oldValue, newValue in
                        if newValue == fieldIdentifier {
                            onFocus?()
                        }
                    }
            } else {
                textField
            }
        }
        // ----- 👆 КРАЙ НА ПРОМЯНАТА -----
    }

    // MARK: - Computed Properties
    private var keyboardType: UIKeyboardType {
        switch type {
        case .integer, .decimal:
            return .numbersAndPunctuation
        case .standard:
            return .default
        }
    }

    // MARK: - Private Methods
    private func handleValidation(oldValue: String, newValue: String) {
           switch type {
           case .standard:
               break
           case .integer:
               let filtered = newValue.filter { "0123456789".contains($0) }
               if filtered != newValue {
                   // ----- 👇 НАЧАЛО НА КОРЕКЦИЯТА 👇 -----
                   DispatchQueue.main.async {
                       value = filtered
                   }
                   // ----- 👆 КРАЙ НА КОРЕКЦИЯТА 👆 -----
               }
           case .decimal:
               if !GlobalState.isValidDecimal(newValue) {
                   // ----- 👇 НАЧАЛО НА КОРЕКЦИЯТА 👇 -----
                   DispatchQueue.main.async {
                       value = oldValue
                   }
                   // ----- 👆 КРАЙ НА КОРЕКЦИЯТА 👆 -----
               }
           }
       }
}

// MARK: - Custom Initializers
// Обновяваме и двата инициализатора, за да приемат новия параметър.

extension ConfigurableTextField {
    
    /// Инициализатор за полета, които ИЗПОЛЗВАТ FocusState.
    init(
        title: String,
        value: Binding<String>,
        type: FieldType,
        placeholderColor: Color? = nil, // <-- НОВ ПАРАМЕТЪР
        focused: FocusState<Field?>.Binding,
        fieldIdentifier: Field,
        onFocus: (() -> Void)? = nil,
        isLanding: Bool = false
    ) {
        self.title = title
        self._value = value
        self.type = type
        self.placeholderColor = placeholderColor // <-- Запазваме го
        self.focused = focused
        self.fieldIdentifier = fieldIdentifier
        self.onFocus = onFocus
        self.isLanding = isLanding
    }

    /// Инициализатор за полета, които НЕ ИЗПОЛЗВАТ FocusState.
    init(
        title: String,
        value: Binding<String>,
        type: FieldType,
        placeholderColor: Color? = nil,
        isLanding: Bool = false
    ) where Field == Never {
        self.title = title
        self._value = value
        self.type = type
        self.placeholderColor = placeholderColor // <-- Запазваме го
        self.isLanding = isLanding
        self.focused = nil
        self.fieldIdentifier = nil
        self.onFocus = nil
    }
}


