    private func splitRows(_ rows: [NutrientRow], priorityNames: Set<String>) -> (prio: [NutrientRow], other: [NutrientRow]) {
        (rows.filter { priorityNames.contains($0.label) },
         rows.filter { !priorityNames.contains($0.label) })
    }
    
