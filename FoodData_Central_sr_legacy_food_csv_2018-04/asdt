    private func findBestFoodItem(
        matching keyword: String,
        for profile: Profile,
        dailyNutrientTotals: [String: Double],
        excluding usedFoodIDs: Set<Int>,
        kcalTarget: Double,
        maxPortionGrams: Double,
        rng: inout LCG
    ) throws -> FoodItem? {
        let searchKey = keyword.foldedSearchKey

        var descriptor = FetchDescriptor<FoodItem>(predicate: #Predicate<FoodItem> { item in
            item.nameNormalized.contains(searchKey) &&
            !item.isUserAdded &&
            !item.isRecipe &&
            !item.isMenu
        })
        descriptor.fetchLimit = 200

        let initialCandidates = try ctx.fetch(descriptor)

        let unwantedCategories: [FoodCategory] = [.babyFoods, .fastFoods, .snacks, .sweets, .soups]
        let unwantedKeywords = ["powder", "dry mix", "formula", "infant", "canned", "uncooked", "dry"]

        let candidates = initialCandidates.filter { item in
            for k in unwantedKeywords where item.name.localizedCaseInsensitiveContains(k) { return false }
            if let itemCategories = item.category, !Set(itemCategories).isDisjoint(with: unwantedCategories) { return false }
            return true
        }

        let focusIDs = buildFocusIDs(profile: profile)

        let scored: [(food: FoodItem, score: Double)] = candidates
            .filter { allowsByAllergens($0, profile) && allowsByDiets($0, profile) }
            .filter { !usedFoodIDs.contains($0.id) }
            .compactMap { food -> (food: FoodItem, score: Double)? in
                if !focusIDs.isEmpty {
                    let relevant = focusIDs.contains { id in
                        if let d = food.nutrientDensity(of: id) { return d > 0 } else { return false }
                    }
                    if !relevant { return nil }
                }
                let kcalPer100 = max(1.0, food.calories(for: 100))
                let gramsNeeded = (kcalTarget / kcalPer100) * 100.0

                var score = focusScore(food, focusIDs)
                if food.nameNormalized.contains(searchKey) { score += 2.0 }
                if food.nameNormalized.contains("cooked") || food.nameNormalized.contains("raw") { score += 0.5 }

                // Energy-density preference relative to grams cap
                if gramsNeeded <= maxPortionGrams {
                    score += 1.8     // bonus: can hit target within realistic grams
                } else {
                    let overshoot = gramsNeeded - maxPortionGrams
                    score -= min(3.0, overshoot / 50.0)  // penalty: needs too many grams
                }

                // small jitter
                score += Double(rng.next() % 1000) / 1_000_000.0

                guard isSafeToAdd(food: food, grams: min(maxPortionGrams, gramsNeeded), dailyTotals: dailyNutrientTotals, profile: profile) else { return nil }
                return (food, score)
            }
            .sorted { $0.score > $1.score }

        return scored.weightedRandom(using: &rng)
    }

    private func isSafeToAdd(food: FoodItem, grams: Double, dailyTotals: [String: Double], profile: Profile) -> Bool {
        let nutrientsInFood = food.nutrients(for: grams)
        let demographic = demographicString(for: profile)
        
        let vitamins = try? ctx.fetch(FetchDescriptor<Vitamin>())
        let minerals = try? ctx.fetch(FetchDescriptor<Mineral>())
        
        let requirementsMap = getRequirementsMap(vitamins: vitamins ?? [], minerals: minerals ?? [], demographic: demographic)
        
        for (nutrientID, amountMg) in nutrientsInFood {
            if let requirement = requirementsMap[nutrientID], let upperLimit = requirement.upperLimit {
                let currentTotal = dailyTotals[nutrientID] ?? 0
                if (currentTotal + amountMg) > upperLimit {
                    onLog?("   - ⚠️ Rejecting '\(food.name)': would exceed UL for \(nutrientID) (\(currentTotal + amountMg) > \(upperLimit))")
                    return false
                }
            }
        }
        return true
    }

    private func calculatePortion(for food: FoodItem, kcalTarget: Double, maxGrams: Double) -> Double {
        let kcalPer100g = food.calories(for: 100)
        guard kcalPer100g > 0 else { return min(100.0, maxGrams) }
        let grams = (kcalTarget / kcalPer100g) * 100.0
        // Keep portions realistic; never exceed the cap
        return clamp(grams, 15, maxGrams)
    }
    
    // MARK: - Prompt & Candidate Helpers
    private func buildFocusIDs(profile: Profile) -> [String] {
        profile.priorityVitamins.map { "vit_\($0.id)" } + profile.priorityMinerals.map { "min_\($0.id)" }
    }

    private func allowsByAllergens(_ food: FoodItem, _ profile: Profile) -> Bool {
        let pfAll = Set(profile.allergens)
        if pfAll.isEmpty { return true }
        let fdAll = Set(food.allergens ?? [])
        return fdAll.isDisjoint(with: pfAll)
    }

    private func allowsByDiets(_ food: FoodItem, _ profile: Profile) -> Bool {
        let pfD = Set(profile.diets)
        guard !pfD.isEmpty else { return true }
        let fd = Set(food.diets ?? [])
        return fd.isEmpty || pfD.isSubset(of: fd)
    }

    // MARK: - General Helpers
    private func buildPrompt(profile: Profile, startDate: Date) -> String {
        let vit = profile.priorityVitamins.map { $0.name }.joined(separator: ", ")
        let min = profile.priorityMinerals.map { $0.name }.joined(separator: ", ")
        let diets = profile.diets.map { $0.name }.joined(separator: ", ")
        let allergens = profile.allergens.map { $0.rawValue }.joined(separator: ", ")
        let mealNames = profile.meals.map { $0.name }.joined(separator: ", ")
        let sports = profile.sports.map { $0.rawValue }.joined(separator: ", ")
        let goal = profile.goal?.title ?? "General Fitness"

        return """
        Goal: Generate a varied 7-day meal plan with common, logical meal components for an adult.
        Provide a JSON response with a list of 7 days. Each day should have meals corresponding to: \(mealNames.isEmpty ? "Breakfast, Lunch, Dinner" : mealNames).
        Each meal should have an array of 3–4 simple food components (e.g., "Chicken Breast", "Brown Rice, cooked", "Broccoli").
        Keep components generic and appropriate for the meal type (e.g., oatmeal for breakfast).
        User profile — Height: \(Int(profile.height)) cm, Weight: \(Int(profile.weight)) kg, Activity: \(profile.activityLevel.description), Goal: \(goal), Sports: \(sports.isEmpty ? "None" : sports).
        Focus on providing components rich in: \(vit.isEmpty ? "general nutrients" : vit)\(min.isEmpty ? "" : ", " + min).
        Adhere to these dietary restrictions: \(diets.isEmpty ? "None" : diets).
        Strictly avoid any components containing: \(allergens.isEmpty ? "None" : allergens).
        Daily energy target: ~\(Int(estimatedDailyCalories(for: profile))) kcal.
        """
    }
    
    private func estimatedDailyCalories(for p: Profile) -> Double {
        let ageY = Calendar.current.dateComponents([.year], from: p.birthday, to: .now).year ?? 30
        let w = max(20, p.weight); let h = max(120, p.height)
        let base = (p.gender.lowercased() == "female") ? (10*w + 6.25*h - 5*Double(ageY) - 161) : (10*w + 6.25*h - 5*Double(ageY) + 5)
        let mult = p.activityLevel.rawValue
        var tdee = base * mult
        if p.isPregnant { tdee += 300 }
        if p.isLactating { tdee += 500 }
        return max(1400, tdee.rounded())
    }

    private func getRequirementsMap(vitamins: [Vitamin], minerals: [Mineral], demographic: String) -> [String: Requirement] {
        var map: [String: Requirement] = [:]
        for v in vitamins {
            if let req = v.requirements.first(where: { $0.demographic == demographic }) {
                map["vit_\(v.id)"] = req
            }
        }
        for m in minerals {
            if let req = m.requirements.first(where: { $0.demographic == demographic }) {
                map["min_\(m.id)"] = req
            }
        }
        return map
    }
    
    private func demographicString(for p: Profile) -> String {
        let isF = p.gender.lowercased().hasPrefix("f")
        if isF { if p.isPregnant { return Demographic.pregnantWomen }; if p.isLactating { return Demographic.lactatingWomen } }
        let m = Calendar.current.dateComponents([.month], from: p.birthday, to: Date()).month ?? 0
        if m < 6 { return Demographic.babies0_6m }; if m < 12 { return Demographic.babies7_12m }
        switch p.age {
        case 1..<4: return Demographic.children1_3y; case 4..<9: return Demographic.children4_8y; case 9..<14: return Demographic.children9_13y
        case 14..<19: return isF ? Demographic.adolescentFemales14_18y : Demographic.adolescentMales14_18y
        default: return isF ? (p.age <= 50 ? Demographic.adultWomen19_50y : Demographic.adultWomen51plusY) : (p.age <= 50 ? Demographic.adultMen19_50y : Demographic.adultMen51plusY)
        }
    }

    private func clamp(_ x: Double, _ lo: Double, _ hi: Double) -> Double { min(max(x, lo), hi) }
    private func round1(_ x: Double) -> Double { (x * 10).rounded() / 10 }
    private func focusScore(_ food: FoodItem, _ ids: [String]) -> Double {
        ids.reduce(0) { acc, id in
            guard let d = food.nutrientDensity(of: id), d.isFinite, d > 0 else { return acc }
            return acc + log1p(d)
        }
    }
