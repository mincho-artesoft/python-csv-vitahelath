                .rotationEffect(Angle(degrees: 270.0))
                .animation(.linear(duration: 0.5), value: progress)
                
            VStack(spacing: 1) {
                // --- НАЧАЛО НА ПРОМЯНАТА (4/4): Използваме новите изчисляеми свойства ---
                Image(systemName: iconName)
                    .font(.caption)
                    .foregroundColor(color)

