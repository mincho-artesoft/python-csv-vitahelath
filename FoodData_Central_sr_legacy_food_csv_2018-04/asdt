    private func checkPermissions() {
        Task {
            var calendarStatus = CalendarViewModel.shared.isCalendarAccessGranted()
            if !calendarStatus {
                calendarStatus = await CalendarViewModel.shared.requestCalendarAccessIfNeeded()
            }
            guard calendarStatus else {
                permissionState = .calendarDenied
                return
            }

            var notificationStatus = await NotificationManager.shared.getAuthorizationStatus()
            if notificationStatus == .notDetermined {
                let granted = await NotificationManager.shared.requestAuthorization()
                if granted {
                    try? await Task.sleep(nanoseconds: 500_000_000)
                    notificationStatus = await NotificationManager.shared.getAuthorizationStatus()
                } else {
                    notificationStatus = .denied
                }
            }
            guard notificationStatus == .authorized else {
                permissionState = .notificationsDenied
                return
            }
            permissionState = .granted
        }
    }

