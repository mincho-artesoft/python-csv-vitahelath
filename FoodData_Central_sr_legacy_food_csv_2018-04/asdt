import SwiftUI

struct IngredientRowView<FocusField: Hashable>: View {
    @ObservedObject private var effectManager = EffectManager.shared
    
    // Приемаме Binding директно към стойността в грамове
    @Binding var grams: Double
    let item: FoodItem
    
    // Генерични FocusState параметри
    @FocusState.Binding var focusedField: FocusField?
    let focusCase: FocusField
    
    var onDelete: () -> Void
    
    // --- NEW: Add maxValueInGrams ---
    let maxValueInGrams: Double?

    // Локално състояние само за текстовото поле
    @State private var textValue: String
    
    private var isImperial: Bool { GlobalState.measurementSystem == "Imperial" }
    private var ingredientUnit: String { isImperial ? "oz" : "g" }
    
    init(
        grams: Binding<Double>,
        item: FoodItem,
        focusedField: FocusState<FocusField?>.Binding,
        focusCase: FocusField,
        onDelete: @escaping () -> Void,
        maxValueInGrams: Double? = nil // <-- NEW
    ) {
        self._grams = grams
        self.item = item
        self._focusedField = focusedField
        self.focusCase = focusCase
        self.onDelete = onDelete
        self.maxValueInGrams = maxValueInGrams // <-- NEW
        
        let isImperialSystem = GlobalState.measurementSystem == "Imperial"
        let displayValue = isImperialSystem ? UnitConversion.gToOz(grams.wrappedValue) : grams.wrappedValue
        self._textValue = State(initialValue: GlobalState.formatDecimalString(String(displayValue)))
    }

    var body: some View {
        HStack {
            Text(item.name)
                .foregroundColor(effectManager.currentGlobalAccentColor)
                // --- MODIFICATION START ---
                .lineLimit(2)
                .frame(maxWidth: .infinity, alignment: .leading)
                // --- MODIFICATION END ---

            // --- MODIFICATION START: Group controls to keep them together ---
            HStack(spacing: 4) {
                ConfigurableTextField(
                    title: ingredientUnit,
                    value: $textValue,
                    type: .decimal,
                    placeholderColor: effectManager.currentGlobalAccentColor.opacity(0.6),
                    focused: $focusedField,
                    fieldIdentifier: focusCase
                )
                .multilineTextAlignment(.trailing)
                .fixedSize() // <-- Let the text field grow to its natural size
                .foregroundStyle(effectManager.currentGlobalAccentColor)

                Text(ingredientUnit)
                    .foregroundStyle(effectManager.currentGlobalAccentColor.opacity(0.8))

                Button(role: .destructive, action: onDelete) {
                    Image(systemName: "trash")
                        .foregroundStyle(effectManager.currentGlobalAccentColor)
                }
                .buttonStyle(.borderless)
                .tint(.red)
            }
            // --- MODIFICATION END ---
        }
        .onChange(of: textValue) { _, newText in
            if let displayValue = UnitConversion.parseDecimal(newText) {
                var newGrams = isImperial ? UnitConversion.ozToG(displayValue) : displayValue

                if let maxGrams = maxValueInGrams, newGrams > maxGrams {
                    newGrams = maxGrams
                    let clampedDisplayValue = isImperial ? UnitConversion.gToOz(newGrams) : newGrams
                    DispatchQueue.main.async {
                        textValue = GlobalState.formatDecimalString(String(clampedDisplayValue))
                    }
                }

                if abs(grams - newGrams) > 0.001 {
                    grams = newGrams
                }
            } else if newText.isEmpty {
                grams = 0.0
            }
        }
        .onChange(of: grams) { _, newGrams in
            let currentTextAsGrams = UnitConversion.parseDecimal(textValue).map { isImperial ? UnitConversion.ozToG($0) : $0 } ?? 0.0
            if abs(currentTextAsGrams - newGrams) > 0.001 {
                let displayValue = isImperial ? UnitConversion.gToOz(newGrams) : newGrams
                textValue = GlobalState.formatDecimalString(String(displayValue))
            }
        }
        .onChange(of: focusedField) { _, newFocus in
            if newFocus != focusCase {
                let displayValue = isImperial ? UnitConversion.gToOz(grams) : grams
                textValue = GlobalState.formatDecimalString(String(displayValue))
            }
        }
    }
}


