            if globalSearchText.isEmpty {
                return viewModel.lists
            } else {
                return viewModel.lists.filter { list in
                    list.items.contains { item in
                        item.name.localizedCaseInsensitiveContains(globalSearchText)
                    }
                }
            }
        }

