fileprivate enum PresentedNode: Identifiable, Equatable {
    case newNode
    case editNode(Node)

    var id: String {
        switch self {
        case .newNode:
            return "newNode"
        case .editNode(let node):
            return "editNode-\(node.id)"
        }
    }

    static func == (lhs: PresentedNode, rhs: PresentedNode) -> Bool {
        lhs.id == rhs.id
    }
}

