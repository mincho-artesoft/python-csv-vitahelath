                            textColor: UIColor(effectManager.currentGlobalAccentColor)
                        )
                        .frame(height: 40)
                    }

                    HStack {
                        Text("End Time")
                            .font(.system(size: 16, weight: .medium))
                            .foregroundColor(effectManager.currentGlobalAccentColor)
                        Spacer()
                        CustomTimePicker(
                            selection: $draft.endTime,
                            textColor: UIColor(effectManager.currentGlobalAccentColor)
                        )
                        .frame(height: 40)
                    }
                    
                    // --- НАЧАЛО НА ПРОМЯНАТА: Добавяме Picker за напомняне ---
                    HStack {
                        Text("Reminder")
                            .font(.system(size: 16, weight: .medium))
                            .foregroundColor(effectManager.currentGlobalAccentColor)
                        Spacer()
                        Picker("Reminder", selection: $reminderOffset) {
