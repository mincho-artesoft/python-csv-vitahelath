                    ProgressView()
                        .progressViewStyle(CircularProgressViewStyle(tint: effectManager.currentGlobalAccentColor))
                        .scaleEffect(1.5) // Правим го малко по-голям

                    Text("Preparing database…")
                        .font(.headline)
                        .fontWeight(.medium)
                        .foregroundColor(effectManager.currentGlobalAccentColor)
                }
                .padding(30)
                .glassCardStyle(cornerRadius: 20) // Използваме същия стъклен ефект
                .transition(.opacity.animation(.easeInOut))
            }
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity)
        .ignoresSafeArea()
        .task(priority: .utility) {
            // Логиката за подготовка на данните остава същата
            await SeedManager.seedIfNeeded(container: container)
            
            let modelContext = container.mainContext
            
            // -- START OF CHANGE --
            // 1. Заявяваме достъп до календара
            let calendarAccessGranted = await CalendarViewModel.shared.requestCalendarAccessIfNeeded()
            
            if calendarAccessGranted {
                // 2. Ако достъпът е даден, извличаме ID-тата на съществуващите профили
                let existingProfiles = try? modelContext.fetch(FetchDescriptor<Profile>())
                let existingCalendarIDs = Set(existingProfiles?.compactMap { $0.calendarID } ?? [])

                // 3. Възстановяваме профили от календарите
                await CalendarViewModel.shared.reconstructProfilesFromCalendars(
                    existingProfileIDs: existingCalendarIDs,
                    allVitamins: allVitamins,
                    allMinerals: allMinerals,
                    context: modelContext
                )
            } else {
                print("Calendar access not granted. Skipping profile reconstruction from calendars.")
            }
            // -- END OF CHANGE --

            withAnimation { isSeeding = false }
        }
    }
