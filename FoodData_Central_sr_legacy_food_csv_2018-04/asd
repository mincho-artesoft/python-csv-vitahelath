        let trimmedName = newMetricName.trimmingCharacters(in: .whitespaces)
        guard !trimmedName.isEmpty,
              let value = UnitConversion.parseDecimal(newMetricValue), value <= maxValueMetric else { return }
        
        withAnimation {
