                    MealSummaryRowEventView(rows: rows)
                        .frame(maxWidth: geo.size.width, alignment: .leading)
                        .tag(0)
                }
                
                // 1…n) Храни
                ForEach(Array(rows.enumerated()), id: \.1.0.id) { idx, pair in
                    // ----- 👇 НАЧАЛО НА КОРЕКЦИЯТА 👇 -----
