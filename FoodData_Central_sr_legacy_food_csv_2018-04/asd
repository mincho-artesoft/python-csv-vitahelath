    private struct DietSelectableNutrient: Identifiable, Hashable {
        let id: String  // "vit_<id>" или "min_<id>"
        let label: String
    }
    
    private func nutrientColor(for id: String) -> Color {
        if id.starts(with: "vit_"),
           let vitamin = allVitamins.first(where: { "vit_\($0.id)" == id }) {
            return Color(hex: vitamin.colorHex)
        }
        if id.starts(with: "min_"),
           let mineral = allMinerals.first(where: { "min_\($0.id)" == id }) {
            return Color(hex: mineral.colorHex)
        }
        return .gray
    }
    
    private func syncFilters(with id: String?) {
        searchVM.selectedNutrientID = id
        if let id {
            if id.hasPrefix("vit_") {
                searchVM.vitaminFilters = [String(id.dropFirst(4))]
                searchVM.mineralFilters = []
            } else {
                searchVM.vitaminFilters = []
                searchVM.mineralFilters = [String(id.dropFirst(4))]
            }
        } else {
            searchVM.vitaminFilters = []
            searchVM.mineralFilters = []
        }
    }
    
