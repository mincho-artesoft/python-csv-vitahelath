        var seen = Set<String>()
        var out: [String] = []
        out.reserveCapacity(self.count)
        for s in self {
            let key = s.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
            guard !key.isEmpty, !seen.contains(key) else { continue }
            seen.insert(key)
            out.append(s)
        }
        return out
    }
