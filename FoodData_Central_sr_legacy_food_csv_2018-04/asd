        .onChange(of: productsToAdd.filter { !$0.isMarkedForDeletion }.map { $0.id }) {
            let foodsToExclude = Set(
                productsToAdd
                    .filter { !$0.isMarkedForDeletion }
                    .map { $0.food }
            )
            searchVM.exclude(foodsToExclude)
        }
        .onAppear {
            searchVM.attach(context: modelContext)
            searchVM.query = globalSearchText
            searchVM.searchContext = .menuEditor
            let foodsToExclude = Set(
                productsToAdd
                    .filter { !$0.isMarkedForDeletion }
                    .map { $0.food }
            )
            searchVM.exclude(foodsToExclude)
        }
        .onChange(of: globalSearchText) { _, newValue in
            if searchVM.query != newValue {
                searchVM.query = newValue
            }
        }
    }
    
    private var customToolbar: some View {
        HStack {
            HStack{
                Button("Cancel") {
                    hideKeyboard()
                    onDismiss(true)
                }
