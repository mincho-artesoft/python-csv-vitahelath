    // MARK: - Calculation & Aggregation
    private func recalcTotals() {
        // --- START OF CORRECTION ---
        // Вече не създаваме временен FoodItem. Изчисляваме сумите директно.
        let m = MacronutrientsData(); let l = LipidsData(); let v = VitaminsData(); let mi = MineralsData(); let o = OtherCompoundsData()
        func add(_ tgt: inout Nutrient?, _ src: Nutrient?, _ k: Double) {
            guard let src, let value = src.value, value > 0 else { return }
            if tgt == nil { tgt = Nutrient(value: value * k, unit: src.unit) }
            else if tgt!.unit == src.unit { tgt!.value! += value * k }
        }
        
        for (item, grams) in selectedIng {
            // Рекурсивно взимаме агрегираните нутриенти за всяка съставка.
            // Това правилно ще обработи случаи, в които съставка е друга рецепта.
            let sourceNutrition = FoodItem.aggregatedNutrition(for: item)
            
            let base = item.referenceWeightG
            guard base > 0 else { continue }
            let f = grams / base
            
            if let x = sourceNutrition.macros { add(&m.carbohydrates, x.carbohydrates, f); add(&m.protein, x.protein, f); add(&m.fat, x.fat, f); add(&m.fiber, x.fiber, f); add(&m.totalSugars, x.totalSugars, f) }
            if let x = sourceNutrition.lipids { add(&l.totalSaturated, x.totalSaturated, f); add(&l.totalMonounsaturated, x.totalMonounsaturated, f); add(&l.totalPolyunsaturated, x.totalPolyunsaturated, f); add(&l.sfa4_0, x.sfa4_0, f); add(&l.sfa6_0, x.sfa6_0, f); add(&l.sfa8_0, x.sfa8_0, f); add(&l.sfa10_0, x.sfa10_0, f); add(&l.sfa12_0, x.sfa12_0, f); add(&l.sfa14_0, x.sfa14_0, f); add(&l.sfa16_0, x.sfa16_0, f); add(&l.sfa18_0, x.sfa18_0, f); add(&l.mufa16_1, x.mufa16_1, f); add(&l.mufa18_1, x.mufa18_1, f); add(&l.mufa20_1, x.mufa20_1, f); add(&l.mufa22_1, x.mufa22_1, f); add(&l.pufa18_2, x.pufa18_2, f); add(&l.pufa18_3, x.pufa18_3, f); add(&l.pufa18_4, x.pufa18_4, f); add(&l.pufa20_4, x.pufa20_4, f); add(&l.pufa20_5_n3, x.pufa20_5_n3, f); add(&l.pufa22_5_n3, x.pufa22_5_n3, f); add(&l.pufa22_6_n3, x.pufa22_6_n3, f) }
            if let x = sourceNutrition.vitamins { add(&v.vitaminA_RAE, x.vitaminA_RAE, f); add(&v.retinol, x.retinol, f); add(&v.caroteneAlpha, x.caroteneAlpha, f); add(&v.caroteneBeta, x.caroteneBeta, f); add(&v.cryptoxanthinBeta, x.cryptoxanthinBeta, f); add(&v.luteinZeaxanthin, x.luteinZeaxanthin, f); add(&v.lycopene, x.lycopene, f); add(&v.vitaminB1_Thiamin, x.vitaminB1_Thiamin, f); add(&v.vitaminB2_Riboflavin, x.vitaminB2_Riboflavin, f); add(&v.vitaminB3_Niacin, x.vitaminB3_Niacin, f); add(&v.vitaminB5_PantothenicAcid, x.vitaminB5_PantothenicAcid, f); add(&v.vitaminB6, x.vitaminB6, f); add(&v.vitaminB7_Biotin, x.vitaminB7_Biotin, f); add(&v.folateDFE, x.folateDFE, f); add(&v.folateFood, x.folateFood, f); add(&v.folateTotal,x.folateTotal,f); add(&v.folicAcid, x.folicAcid, f); add(&v.vitaminB12, x.vitaminB12, f); add(&v.vitaminB12Added, x.vitaminB12Added, f); add(&v.vitaminC, x.vitaminC, f); add(&v.vitaminD, x.vitaminD, f); add(&v.vitaminE, x.vitaminE, f); add(&v.vitaminEAdded, x.vitaminEAdded, f); add(&v.vitaminK, x.vitaminK, f); add(&v.choline, x.choline, f) }
            if let x = sourceNutrition.minerals { add(&mi.calcium, x.calcium, f); add(&mi.phosphorus, x.phosphorus, f); add(&mi.magnesium, x.magnesium, f); add(&mi.potassium, x.potassium, f); add(&mi.sodium, x.sodium, f); add(&mi.chloride, x.chloride, f); add(&mi.iron, x.iron, f); add(&mi.zinc, x.zinc, f); add(&mi.copper, x.copper, f); add(&mi.manganese, x.manganese, f); add(&mi.selenium, x.selenium, f); add(&mi.iodine, x.iodine, f); add(&mi.chromium, x.chromium, f); add(&mi.molybdenum, x.molybdenum, f); add(&mi.fluoride, x.fluoride, f) }
            if let x = sourceNutrition.other { add(&o.alcoholEthyl, x.alcoholEthyl, f); add(&o.caffeine, x.caffeine, f); add(&o.theobromine, x.theobromine, f); add(&o.cholesterol, x.cholesterol, f); add(&o.energyKcal, x.energyKcal, f); add(&o.water, x.water, f); add(&o.weightG, x.weightG, f) }
        }
        
        macros = MacroForm(from: m)
        lipids = LipidForm(from: l)
        vitamins = VitaminForm(from: v)
        minerals = MineralForm(from: mi)
        others = OtherForm(from: o)
        // --- END OF CORRECTION ---
    }
    
    private func recalcTags() {
        guard !selectedIng.isEmpty else {
            selectedCategories = []; selectedDiets = []; selectedAllergens = []
            return
        }
        
        var catUnion = Set<FoodCategory.ID>()
        var dietsIntersection = Set(Diet.allCases.map(\.id))
        var allUnion = Set<Allergen.ID>()
        
        for (index, item) in selectedIng.keys.enumerated() {
            let itemDiets = Set(item.diets?.map(\.id) ?? [])
            catUnion.formUnion(item.category?.map(\.id) ?? [])
            allUnion.formUnion(item.allergens?.map(\.id) ?? [])
            
            if index == 0 {
                dietsIntersection = itemDiets
            } else {
                dietsIntersection.formIntersection(itemDiets)
            }
        }
        
        selectedCategories = catUnion
        selectedDiets = dietsIntersection
        selectedAllergens = allUnion
    }

    private static func aggregatedNutrition(for recipe: FoodItem) -> (macros: MacronutrientsData?, lipids: LipidsData?, vitamins: VitaminsData?, minerals: MineralsData?, other: OtherCompoundsData?) {
        guard let links = recipe.ingredients, !links.isEmpty else {
            return (recipe.macronutrients, recipe.lipids, recipe.vitamins, recipe.minerals, recipe.other)
        }
        
        let m = MacronutrientsData(); let l = LipidsData(); let v = VitaminsData(); let mi = MineralsData(); let o = OtherCompoundsData()
        
        func add(_ tgt: inout Nutrient?, _ src: Nutrient?, _ k: Double) {
            guard let src, let value = src.value else { return }
            if tgt == nil { tgt = Nutrient(value: value * k, unit: src.unit) }
            else if tgt!.unit == src.unit { tgt!.value! += value * k }
        }
        
        for link in links {
            guard let ing = link.food else { continue }
            let base = ing.other?.weightG?.value ?? 1.0
            guard base > 0 else { continue }
            let f = link.grams / base
            
