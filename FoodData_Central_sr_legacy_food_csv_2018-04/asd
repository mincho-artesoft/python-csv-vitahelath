        DropdownMenu(selection: selection,
                     items: items,
                     label: label,
                     selectAllBtn: selectAllBtn)
    }

    @ViewBuilder
    private func tagPicker<I: Identifiable & Hashable>(
        label: String,
        selection: Binding<Set<I.ID>>,
        items: [I],
        menu: OpenMenu
    ) -> some View {
