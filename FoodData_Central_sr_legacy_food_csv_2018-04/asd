                let startDay = cal.startOfDay(for: ekEvent.startDate)
                let endDay   = cal.startOfDay(for: ekEvent.endDate ?? ekEvent.startDate)
                
                if startDay != endDay || ekEvent.isAllDay {
                    let parts = splitEventByDays(ekEvent,
