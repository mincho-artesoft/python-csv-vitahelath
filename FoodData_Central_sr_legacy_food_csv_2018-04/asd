    // MARK: - Save Logic
    private func save() {
          // ----- 👇 НАЧАЛО НА ПРОМЯНА 4: Премахваме ръчното задаване на others.weightG -----
          // Вече се случва автоматично чрез onChange(of: servingWeightString)
          // ----- 👆 КРАЙ НА ПРОМЯНА 4 -----
          let totalWeight: Double = others.weightG?.value ?? 0
          let carbs: Double = macros.carbohydrates?.value ?? 0
          let protein: Double = macros.protein?.value ?? 0
          let fat: Double = macros.fat?.value ?? 0
          let macroSum = carbs + protein + fat

          if macroSum > totalWeight {
              alertMsg = String(format: "The sum of carbohydrates, protein, and fat (%.1f g) cannot exceed the total serving weight (%.1f g).", macroSum, totalWeight)
              showAlert = true; return
          }

          let item: FoodItem = food ?? {
              let nextID = (try? ctx.fetchCount(FetchDescriptor<FoodItem>())) ?? 0
              let new = FoodItem(id: nextID + 1, name: name, isUserAdded: true)
              ctx.insert(new); return new
          }()

          item.name = name
          item.photo = photoData
          item.category = idsToEnums(selectedCategories, of: FoodCategory.self)
          item.diets = idsToEnums(selectedDiets, of: Diet.self)
          item.allergens = idsToEnums(selectedAllergens, of: Allergen.self)
          item.itemDescription = itemDescription.trimmingCharacters(in: .whitespacesAndNewlines).nilIfEmpty()
          item.macronutrients = MacronutrientsData(carbohydrates: macros.carbohydrates, protein: macros.protein, fat: macros.fat, fiber: macros.fiber, totalSugars: macros.totalSugars)
          item.lipids = LipidsData(totalSaturated: lipids.totalSaturated, totalMonounsaturated: lipids.totalMonounsaturated, totalPolyunsaturated: lipids.totalPolyunsaturated, sfa4_0: lipids.sfa4_0, sfa6_0: lipids.sfa6_0, sfa8_0: lipids.sfa8_0, sfa10_0: lipids.sfa10_0, sfa12_0: lipids.sfa12_0, sfa14_0: lipids.sfa14_0, sfa16_0: lipids.sfa16_0, sfa18_0: lipids.sfa18_0, mufa16_1: lipids.mufa16_1, mufa18_1: lipids.mufa18_1, mufa20_1: lipids.mufa20_1, mufa22_1: lipids.mufa22_1, pufa18_2: lipids.pufa18_2, pufa18_3: lipids.pufa18_3, pufa18_4: lipids.pufa18_4, pufa20_4: lipids.pufa20_4, pufa20_5_n3: lipids.pufa20_5_n3, pufa22_5_n3: lipids.pufa22_5_n3, pufa22_6_n3: lipids.pufa22_6_n3)
          item.vitamins = VitaminsData(vitaminA_RAE: vitamins.vitaminA_RAE, retinol: vitamins.retinol, caroteneAlpha: vitamins.caroteneAlpha, caroteneBeta: vitamins.caroteneBeta, cryptoxanthinBeta: vitamins.cryptoxanthinBeta, luteinZeaxanthin: vitamins.luteinZeaxanthin, lycopene: vitamins.lycopene, vitaminB1_Thiamin: vitamins.vitaminB1_Thiamin, vitaminB2_Riboflavin: vitamins.vitaminB2_Riboflavin, vitaminB3_Niacin: vitamins.vitaminB3_Niacin, vitaminB5_PantothenicAcid: vitamins.vitaminB5_PantothenicAcid, vitaminB6: vitamins.vitaminB6, vitaminB7_Biotin: vitamins.vitaminB7_Biotin, folateDFE: vitamins.folateDFE, folateFood: vitamins.folateFood, folateTotal: vitamins.folateTotal, folicAcid: vitamins.folicAcid, vitaminB12: vitamins.vitaminB12, vitaminB12Added: vitamins.vitaminB12Added, vitaminC: vitamins.vitaminC, vitaminD: vitamins.vitaminD, vitaminE: vitamins.vitaminE, vitaminEAdded: vitamins.vitaminEAdded, vitaminK: vitamins.vitaminK, choline: vitamins.choline)
          item.minerals = MineralsData(calcium: minerals.calcium, phosphorus: minerals.phosphorus, magnesium: minerals.magnesium, potassium: minerals.potassium, sodium: minerals.sodium, chloride: minerals.chloride, iron: minerals.iron, zinc: minerals.zinc, copper: minerals.copper, manganese: minerals.manganese, selenium: minerals.selenium, iodine: minerals.iodine, chromium: minerals.chromium, molybdenum: minerals.molybdenum, fluoride: minerals.fluoride)
          item.other = OtherCompoundsData(alcoholEthyl: others.alcoholEthyl, caffeine: others.caffeine, theobromine: others.theobromine, cholesterol: others.cholesterol, energyKcal: others.energyKcal, water: others.water, weightG: others.weightG)
          
          do {
              try ctx.save()
              // --- NEW: Trigger re-indexing in the background ---
              Task {
