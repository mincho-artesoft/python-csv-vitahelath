                0:  (2.5, 4.5),
                1:  (3.0, 5.5),
                3:  (4.5, 7.5),
                6:  (6.0, 9.5),
                9:  (7.0, 11.0),
                12: (8.0, 12.5),
                18: (9.0, 14.0),
                24: (10.0, 16.0),
