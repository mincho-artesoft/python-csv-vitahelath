            backoffMs: Int = 400,
            salvageAfter: Int = 3,
            maxTokens: Int? = nil,
            salvage: (() async throws -> T)? = nil
        ) async throws -> T {
            var attempt = 0
            var lastError: Error?
            
            while attempt <= retries {
                try Task.checkCancellation() // <-- ДОБАВЕТЕ ТОВА
                
                attempt += 1
                // ... останалата част от функцията остава същата ...
