    private func formatAllInputs() {
        let currentWeightDisplay = UnitConversion.parseDecimal(weight)
        let currentHeightDisplay = UnitConversion.parseInteger(height).map(Double.init)
        // +++ НАЧАЛО НА ПРОМЯНА 8: Форматираме и новото поле +++
        let currentHeadCircumferenceDisplay = UnitConversion.parseInteger(headCircumference).map(Double.init)
        // +++ КРАЙ НА ПРОМЯНАТА 8 +++

        let weightKg = GlobalState.measurementSystem == "Imperial" ? UnitConversion.lbsToKg(currentWeightDisplay ?? 0) : (currentWeightDisplay ?? 0)
        let heightCm = GlobalState.measurementSystem == "Imperial" ? UnitConversion.inchesToCm(currentHeightDisplay ?? 0) : (currentHeightDisplay ?? 0)
        // +++ НАЧАЛО НА ПРОМЯНА 9: Конвертираме и новото поле +++
        let headCircumferenceCm = GlobalState.measurementSystem == "Imperial" ? UnitConversion.inchesToCm(currentHeadCircumferenceDisplay ?? 0) : (currentHeadCircumferenceDisplay ?? 0)
        // +++ КРАЙ НА ПРОМЯНАТА 9 +++

        let clampedWeightKg = min(max(0, weightKg), 500.0)
        let clampedHeightCm = min(max(0, heightCm), 300.0)
        // +++ НАЧАЛО НА ПРОМЯНА 10: Ограничаваме и новото поле +++
        let clampedHeadCircumferenceCm = min(max(0, headCircumferenceCm), 100.0) // 100cm е разумна горна граница
        // +++ КРАЙ НА ПРОМЯНАТА 10 +++

        if GlobalState.measurementSystem == "Imperial" {
            weight = UnitConversion.formatDecimal(UnitConversion.kgToLbs(clampedWeightKg))
            height = UnitConversion.formatInteger(UnitConversion.cmToInches(clampedHeightCm))
            // +++ НАЧАЛО НА ПРОМЯНА 11: Форматираме и новото поле +++
            headCircumference = UnitConversion.formatInteger(UnitConversion.cmToInches(clampedHeadCircumferenceCm))
            // +++ КРАЙ НА ПРОМЯНАТА 11 +++
        } else {
            weight = UnitConversion.formatDecimal(clampedWeightKg)
            height = UnitConversion.formatInteger(clampedHeightCm)
            // +++ НАЧАЛО НА ПРОМЯНА 12: Форматираме и новото поле +++
            headCircumference = UnitConversion.formatInteger(clampedHeadCircumferenceCm)
            // +++ КРАЙ НА ПРОМЯНАТА 12 +++
        }
    }

