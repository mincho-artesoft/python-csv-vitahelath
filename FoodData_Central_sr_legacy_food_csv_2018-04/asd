    private func calculateWaterGoal(for profile: Profile) -> Int {
        let weight = profile.weight
        let age = profile.age

        let mlPerKg: Double

        switch age {
        case 0...15:
            mlPerKg = 40.0
        case 16...30:
            mlPerKg = 35.0
        case 31...54:
            mlPerKg = 32.5
        case 55...65:
            mlPerKg = 30.0
        default:
            mlPerKg = 25.0
        }

        let totalMilliliters = weight * mlPerKg
        let numberOfGlasses = Int(round(totalMilliliters / 200.0))

        return max(4, numberOfGlasses)
    }
    
