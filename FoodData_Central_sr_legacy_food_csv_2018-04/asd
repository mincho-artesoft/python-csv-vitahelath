// MARK: - Color Analysis Data Structures (Unchanged)
private struct ColorBucket {
    private var count: Int = 0
    private var accumulatedHue: CGFloat = 0
    private var accumulatedSaturation: CGFloat = 0
    private var accumulatedBrightness: CGFloat = 0

    var score: CGFloat {
        return averageSaturation * CGFloat(count)
    }
    
    var averageColor: UIColor? {
        guard count > 0 else { return nil }
        return UIColor(
            hue: accumulatedHue / CGFloat(count),
            saturation: accumulatedSaturation / CGFloat(count),
            brightness: accumulatedBrightness / CGFloat(count),
            alpha: 1.0
        )
    }
    
    var averageSaturation: CGFloat {
        guard count > 0 else { return 0 }
        return accumulatedSaturation / CGFloat(count)
    }

    mutating func add(hue: CGFloat, saturation: CGFloat, brightness: CGFloat) {
        count += 1
        accumulatedHue += hue
        accumulatedSaturation += saturation
        accumulatedBrightness += brightness
    }
}


