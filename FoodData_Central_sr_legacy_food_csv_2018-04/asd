    private func format(_ v: Double, for key: String) -> String {
          switch key {
          case "Weight": return "\(UnitConversion.formatDecimal(v)) \(weightUnit)"
          case "Height": return "\(UnitConversion.formatInteger(v)) \(heightUnit)"
          // +++ НАЧАЛО НА ПРОМЯНА 4: Добавяме форматиране за новия тип +++
          case "Head Circ.": return "\(UnitConversion.formatInteger(v)) \(heightUnit)"
          // +++ КРАЙ НА ПРОМЯНАТА 4 +++
