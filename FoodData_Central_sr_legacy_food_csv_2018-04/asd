    private var filterChipItems: [NutriItem] {
        let priorityItems = collapsedItemsState ?? []
        let priorityIDs = Set(priorityItems.compactMap { $0.nutrientID })
        
        let otherItems = (allItemsState ?? []).filter { item in
            guard let id = item.nutrientID else { return false }
            return !priorityIDs.contains(id)
        }
        
        return priorityItems + otherItems
    }
    
