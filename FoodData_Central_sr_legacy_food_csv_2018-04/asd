            folateDFE += f * nv(food.vitamins?.folateDFE)
            folateFood += f * nv(food.vitamins?.folateFood)
            folateTotal += f * nv(food.vitamins?.folateTotal)
            folicAcid += f * nv(food.vitamins?.folicAcid)
            b12       += f * nv(food.vitamins?.vitaminB12)
