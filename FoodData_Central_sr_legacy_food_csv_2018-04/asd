    private func repsBinding(for setBinding: Binding<WorkoutSet>) -> Binding<String> {
        Binding<String>(
            get: {
                if let reps = setBinding.wrappedValue.reps { return String(reps) }
                return ""
            },
            set: { newValue in
                if let newReps = Int(newValue) {
                    setBinding.wrappedValue.reps = newReps
                } else if newValue.isEmpty {
                    setBinding.wrappedValue.reps = nil
                }
            }
        )
    }
    
    private func weightBinding(for setBinding: Binding<WorkoutSet>) -> Binding<String> {
        Binding<String>(
            get: {
                if let weight = setBinding.wrappedValue.weight {
                    let displayWeight = isImperial ? UnitConversion.kgToLbs(weight) : weight
                    return GlobalState.formatDecimalString(String(displayWeight))
                }
                return ""
            },
            set: { newValue in
                if let displayValue = GlobalState.double(from: newValue) {
                    let weightInKg = isImperial ? UnitConversion.lbsToKg(displayValue) : displayValue
                    setBinding.wrappedValue.weight = weightInKg
                } else if newValue.isEmpty {
                    setBinding.wrappedValue.weight = nil
                }
            }
        )
    }

    @ViewBuilder
    private var exerciseImage: some View {
        if let photoData = exercise.photo, let uiImage = UIImage(data: photoData) {
            Image(uiImage: uiImage).resizable().scaledToFill().clipShape(Circle())
        } else if let assetName = exercise.assetImageName, let uiImage = UIImage(named: assetName) {
