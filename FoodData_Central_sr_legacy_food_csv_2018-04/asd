                        view.lineLimit(2)
                    }
                    .contentShape(Rectangle()) // Увеличава зоната за тапване
                    .onTapGesture {
                        // Анимираме промяната
                        withAnimation(.easeInOut(duration: 0.3)) {
                            // При тапване, превключваме състоянието.
                            if isExpanded {
                                expandedItemID = nil // Свиваме го, ако вече е разпънат
