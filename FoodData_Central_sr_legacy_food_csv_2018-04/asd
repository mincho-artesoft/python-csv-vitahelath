                    }
                } else {
                    print("   - No meal plan slots are linked to this menu.")
                }
            } catch {
                print("   - ❌ Failed to fetch linked meal plan meals: \(error)")
            }
        }
        // --- END OF MODIFICATION ---
        
        ctx.delete(item)
