        .onChange(of: selectedTimeRange) { _, newRange in
            if newRange == .custom {
                if customStartDate == nil {
                    let weekRange = calculateCurrentWeekRange()
                    customStartDate = weekRange.start
                    customEndDate = weekRange.end
