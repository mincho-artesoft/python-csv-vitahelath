            let sampleSize = min(width * height, 5000)
            
            for _ in 0..<sampleSize {
                let x = Int.random(in: 0..<width)
                let y = Int.random(in: 0..<height)
                let pixelOffset = (y * bytesPerRow) + (x * bytesPerPixel)
                
                guard pixelOffset + (bytesPerPixel - 1) < CFDataGetLength(data) else { continue }
                
                let r = CGFloat(pointer[pixelOffset]) / 255.0
                let g = CGFloat(pointer[pixelOffset + 1]) / 255.0
                let b = CGFloat(pointer[pixelOffset + 2]) / 255.0
                
                let luminance = (0.2126 * r) + (0.7152 * g) + (0.0722 * b)
                totalLuminance += luminance
                validPixelCount += 1
                
                var hue: CGFloat = 0, saturation: CGFloat = 0, brightness: CGFloat = 0
                UIColor(red: r, green: g, blue: b, alpha: 1.0).getHue(&hue, saturation: &saturation, brightness: &brightness, alpha: nil)

                guard saturation > 0.35 && brightness > 0.3 && brightness < 0.9 else {
                    continue
                }

                let bucketIndex = Int(hue * 6.0) % 6
                colorBuckets[bucketIndex].add(hue: hue, saturation: saturation, brightness: brightness)
            }
            
            guard validPixelCount > 0 else { return (nil, 0.5) }
            
            let bestBucket = colorBuckets.max(by: { $0.score < $1.score })
            let averageLuminance = totalLuminance / CGFloat(validPixelCount)
            return (bestBucket?.averageColor, averageLuminance)
        }.value

        let averageLuminance = analysisResult.1

        return averageLuminance > 0.5 ? .black : .white
    }
    
