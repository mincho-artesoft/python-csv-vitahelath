@MainActor
enum IndexingManager {

    /// Updates the nutrient and name indexes for a single FoodItem.
    /// This should be called after a FoodItem is created, duplicated, or modified.
    static func updateIndexes(for foodItem: FoodItem, context: ModelContext) async {
        print("🚀 Starting indexing for: \(foodItem.name) (ID: \(foodItem.id))")

        // 1. Update all nutrient-based indexes
        await updateNutrientIndexes(for: foodItem, context: context)
        
        // 2. Update the name-based index
        await updateNameIndex(for: foodItem, context: context)

        // 3. Save any changes made to the indexes
        do {
            if context.hasChanges {
                try context.save()
                print("✅ Indexing complete and saved for: \(foodItem.name)")
            } else {
                print("ℹ️ No index changes to save for: \(foodItem.name)")
            }
        } catch {
            print("❌ Failed to save context after indexing: \(error)")
        }
    }

    private static func updateNutrientIndexes(for foodItem: FoodItem, context: ModelContext) async {
        // Fetch all possible nutrient IDs to iterate through
        let allVitamins = (try? context.fetch(FetchDescriptor<Vitamin>())) ?? []
        let allMinerals = (try? context.fetch(FetchDescriptor<Mineral>())) ?? []
        let allNutrientIDs = allVitamins.map { "vit_\($0.id)" } + allMinerals.map { "min_\($0.id)" }

        // Fetch all index objects at once for efficiency
        let allIndexes = (try? context.fetch(FetchDescriptor<NutrientIndex>())) ?? []
        let indexMap = Dictionary(uniqueKeysWithValues: allIndexes.map { ($0.nutrientID, $0) })

        for nutrientID in allNutrientIDs {
            // Get or create the index for the current nutrient
            let index = indexMap[nutrientID] ?? NutrientIndex(nutrientID: nutrientID, rankedFoods: [])
            if index.modelContext == nil {
                context.insert(index)
            }

            // Remove the old entry for this food item, if it exists
            index.rankedFoods.removeAll { $0.foodID == foodItem.id }

            // Get the aggregated nutrient value. This works for simple foods, recipes, and menus.
            guard let (value, unit) = foodItem.value(of: nutrientID), value > 0 else {
                continue // No value for this nutrient, so nothing to index.
            }

            // Normalize to per 100 g
            let referenceWeight = foodItem.referenceWeightG
            guard referenceWeight > 0 else { continue }

            let valuePer100g = (value / referenceWeight) * 100.0
            let valueInMg = toMg(value: valuePer100g, unit: unit)
            guard valueInMg > 0.00001 else { continue }
            
            // Create the new rank object
            let newRank = FoodRank(foodID: foodItem.id, value: valueInMg, nameKey: foodItem.nameNormalized)
            
            // Insert in descending order
            if let insertionIndex = index.rankedFoods.firstIndex(where: { $0.value < newRank.value }) {
                index.rankedFoods.insert(newRank, at: insertionIndex)
            } else {
                index.rankedFoods.append(newRank)
            }
        }
    }
    
    private static func updateNameIndex(for foodItem: FoodItem, context: ModelContext) async {
        let descriptor = FetchDescriptor<NameIndex>()
        guard let nameIndex = (try? context.fetch(descriptor))?.first else {
             print("⚠️ NameIndex not found. Cannot update name for \(foodItem.name).")
            return
        }

        // Remove old entry if it exists to prevent duplicates
        nameIndex.entries.removeAll { $0.foodID == foodItem.id }
        
        // Add the new or updated entry
        let newEntry = NameEntry(foodID: foodItem.id, nameKey: foodItem.nameNormalized)
        nameIndex.entries.append(newEntry)
    }
}
