                               // +++ НАЧАЛО НА КОРЕКЦИЯТА +++
                               withAnimation(.easeInOut) {
                                   presentedSheet = .dateRange
                               }
                               // +++ КРАЙ НА КОРЕКЦИЯТА +++
                           }
            )
            .padding(.horizontal)

            ScrollView {
                VStack(spacing: 20) {
                    timeRangePicker
                    metricSelectorSection
                    chartsSection
                }
                .padding()
                Spacer(minLength: 150)
