                            .lineLimit(2)
                    }

                    if displayWeightG != nil || displayKcal != nil {
                        weightAndCaloriesText()
                            .font(.caption2)
                            .foregroundColor(effectManager.currentGlobalAccentColor.opacity(0.8))
                            .padding(.top, 2)
                    }
                }
                .layoutPriority(1)
            }

