    private func idsToEnums<E: CaseIterable & Identifiable>(_ ids: Set<E.ID>, of _: E.Type) -> [E]? where E.ID == String {
        let all = E.allCases as! [E]
        let filtered = all.filter { ids.contains($0.id) }
        return filtered.isEmpty ? nil : filtered
    }
    
