                    HStack(spacing: 0) {
                        Rectangle().fill(Color(hex: "4A86E8")).frame(width: (protein / totalWeight) * UIScreen.main.bounds.width)
                        Rectangle().fill(Color(hex: "FCC934")).frame(width: (carbs / totalWeight) * UIScreen.main.bounds.width)
                        Rectangle().fill(Color(hex: "34A853")).frame(width: (fat / totalWeight) * UIScreen.main.bounds.width)
                    }
                    .clipShape(Capsule())
                }
                .frame(height: 12)

                HStack {
                    legendItem(label: "Protein", value: protein, color: Color(hex: "4A86E8"), macroType: .protein)
                    Spacer()
                    legendItem(label: "Carbs", value: carbs, color: Color(hex: "FCC934"), macroType: .carbs)
                    Spacer()
                    legendItem(label: "Fat", value: fat, color: Color(hex: "34A853"), macroType: .fat)
                }
                .font(.caption)
            }
        }
        
        @ViewBuilder
        private func legendItem(label: String, value: Double, color: Color, macroType: SelectedMacro) -> some View {
            Button(action: {
                withAnimation {
                    if selectedMacro == macroType {
                        selectedMacro = nil
                    } else {
                        selectedMacro = macroType
                    }
                }
            }) {
                HStack(spacing: 4) {
                    Circle().fill(color).frame(width: 8, height: 8)
                    Text(label)
                        .foregroundColor(effectManager.currentGlobalAccentColor.opacity(0.8))
                    Text(value.clean + "g")
                        .foregroundColor(effectManager.currentGlobalAccentColor.opacity(0.8))
                }
                .padding(6)
                .background(selectedMacro == macroType ? color.opacity(0.2) : Color.clear)
