            let smartFoodSearch = SmartFoodSearch(container: container)
            let resultIDs = await smartFoodSearch.searchFoodsAI(query: query)

            if !Task.isCancelled {
                await MainActor.run {
                    self.foodResults = resultIDs.compactMap { id in
