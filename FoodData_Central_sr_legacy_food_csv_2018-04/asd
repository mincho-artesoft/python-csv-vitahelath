    private func mergedFoods(_ meals: [Meal.ID : [FoodItem : Double]]) -> [FoodItem : Double] {
        var merged: [FoodItem : Double] = [:]
        for (_, foods) in meals {
            for (item, g) in foods {
                merged[item, default: 0] += g
            }
        }
        return merged
    }
    
