import SwiftUI
import SwiftData

struct StorageEditorView: View {
    let owner: Profile
    @Binding var globalSearchText: String
    let onDismiss: (_ shouldDismissGlobalSearch: Bool) -> Void
    @ObservedObject private var effectManager = EffectManager.shared

