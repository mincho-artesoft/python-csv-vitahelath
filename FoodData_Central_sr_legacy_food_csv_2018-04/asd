    // ==== НОВАТА, ПОДОБРЕНА ВЕРСИЯ НА collapsibleHeader ====
    @ViewBuilder
    private func collapsibleHeader(_ title: String, isExpanded: Binding<Bool>, hasOtherItems: Bool = true) -> some View {
        // 1. Обвиваме целия HStack в един голям Button.
        Button(action: {
            // 2. Действието е същото - да превключва състоянието с анимация.
            withAnimation { isExpanded.wrappedValue.toggle() }
        }) {
            // 3. Съдържанието (label) на бутона е целият ред.
            HStack {
                Text(title)
                    .font(.headline)
                    .foregroundStyle(effectManager.currentGlobalAccentColor)
                
                Spacer()
                
                if hasOtherItems {
                    // 4. Иконата вече е просто Image, а не отделен бутон.
                    Image(systemName: isExpanded.wrappedValue ? "chevron.up" : "chevron.down")
                        .font(.body.weight(.semibold))
                        .foregroundColor(effectManager.currentGlobalAccentColor)
                        .contentTransition(.symbolEffect(.replace))
                }
            }
            // 5. Увеличаваме площта за докосване, за да включва и празното пространство от Spacer.
            .contentShape(Rectangle())
        }
        // 6. Използваме .plain стил, за да няма нежелани визуални ефекти по целия ред.
        .buttonStyle(.plain)
        // 7. Деактивираме бутона, ако няма какво да се разгъва.
        .disabled(!hasOtherItems)
    }
    
