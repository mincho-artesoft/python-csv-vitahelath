                                    Text(ex.searchTokens.joined(separator: ", "))
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                            }
                        }
                    }
                }
            }
            .navigationTitle("Smart Search Test")
        }
    }

    // MARK: - Search
    private func performSearch(query: String, in domain: SearchDomain) async {
        let container = modelContext.container

        switch domain {
