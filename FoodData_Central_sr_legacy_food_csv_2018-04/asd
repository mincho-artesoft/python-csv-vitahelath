import SwiftUI
import UIKit

struct CustomSegmentedControl: UIViewRepresentable {
    
    // Входни данни за контрола
    var items: [String]
    @Binding var selection: Int
    var accentColor: Color

    // Тази функция създава UIKit View-то за първи път.
    func makeUIView(context: Context) -> UISegmentedControl {
        let control = UISegmentedControl(items: items)
        
        // Свързваме Coordinator-а, за да обработваме натисканията на потребителя
        control.addTarget(
            context.coordinator,
            action: #selector(Coordinator.updateSelection(sender:)),
            for: .valueChanged
        )
        
        return control
    }

    // ТОВА Е КЛЮЧОВАТА ФУНКЦИЯ!
    // Тя се извиква всеки път, когато някоя от променливите по-горе се промени (напр. accentColor).
    // Тук прилагаме стила ДИРЕКТНО към инстанцията на контрола.
    func updateUIView(_ uiView: UISegmentedControl, context: Context) {
        // Уверяваме се, че избраният сегмент е актуален
        uiView.selectedSegmentIndex = selection
        
        // Преобразуваме SwiftUI Color в UIColor
        let uiColor = UIColor(accentColor)
        
        // Прилагаме стиловете
        uiView.setTitleTextAttributes([.foregroundColor: uiColor], for: .normal)
        uiView.setTitleTextAttributes([.foregroundColor: uiColor], for: .selected)
        uiView.backgroundColor = .clear
        uiView.selectedSegmentTintColor = uiColor.withAlphaComponent(0.2)
    }

    // Coordinator-ът служи като "мост" между UIKit и SwiftUI,
    // за да можем да обновяваме @Binding променливата.
    func makeCoordinator() -> Coordinator {
        Coordinator(self)
    }
    
    class Coordinator: NSObject {
        var parent: CustomSegmentedControl
        
        init(_ parent: CustomSegmentedControl) {
            self.parent = parent
        }
        
        // Когато потребителят избере нов сегмент, тази функция се извиква
        // и обновява @Binding променливата в SwiftUI.
        @MainActor @objc func updateSelection(sender: UISegmentedControl) {
            parent.selection = sender.selectedSegmentIndex
        }
    }
}


