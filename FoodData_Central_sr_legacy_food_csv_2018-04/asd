// MARK: – Главният DTO
struct FoodItemDTO: Codable {

    // ───── Basic info ─────
    var id: Int
    var name: String
    var category: [FoodCategory]?

    // ───── Етикети/таксономия ─────
    var diets:              [Diet]?
    var allergens:          [Allergen]?

    // ───── Вложените блокове от JSON ─────
    var macronutrients: MacronutrientsDTO?
    var lipids:         LipidsDTO?
    var vitamins:       VitaminsDTO?
    var minerals:       MineralsDTO?
    var other:          OtherDTO?

    // MARK: – Conversion to SwiftData model ---------------------------------
    var model: FoodItem {
        // 1) Създаваме основния обект
        let item = FoodItem(
            id: id,
            name: name,
            category: category,
            diets: diets ?? [],
            allergens: allergens ?? []
        )

        // 2) Макронутриенти
        if let m = macronutrients {
            item.macronutrients = MacronutrientsData(
                carbohydrates: m.carbohydrates,
                protein:       m.protein,
                fat:           m.fat,
                fiber:         m.fiber,
                totalSugars:   m.totalSugars
            )
            item.macronutrients?.foodItem = item
        }

        // 3) Липиди
        if let l = lipids {
            item.lipids = LipidsData(
                totalSaturated:       l.totalSaturated,
                totalMonounsaturated: l.totalMonounsaturated,
                totalPolyunsaturated: l.totalPolyunsaturated,
                sfa4_0: l.sfa4_0,  sfa6_0: l.sfa6_0,  sfa8_0: l.sfa8_0,  sfa10_0: l.sfa10_0,
                sfa12_0: l.sfa12_0, sfa14_0: l.sfa14_0, sfa16_0: l.sfa16_0, sfa18_0: l.sfa18_0,
                mufa16_1: l.mufa16_1, mufa18_1: l.mufa18_1, mufa20_1: l.mufa20_1, mufa22_1: l.mufa22_1,
                pufa18_2: l.pufa18_2, pufa18_3: l.pufa18_3, pufa18_4: l.pufa18_4, pufa20_4: l.pufa20_4,
                pufa20_5_n3: l.pufa20_5_n3, pufa22_5_n3: l.pufa22_5_n3, pufa22_6_n3: l.pufa22_6_n3
            )
            item.lipids?.foodItem = item
        }

        // 4) Витамини
        if let v = vitamins {
            item.vitamins = VitaminsData(
                vitaminA_RAE: v.vitaminA_RAE, retinol: v.retinol,
                caroteneAlpha: v.caroteneAlpha, caroteneBeta: v.caroteneBeta,
                cryptoxanthinBeta: v.cryptoxanthinBeta, luteinZeaxanthin: v.luteinZeaxanthin,
                lycopene: v.lycopene,
                vitaminB1_Thiamin: v.vitaminB1_Thiamin, vitaminB2_Riboflavin: v.vitaminB2_Riboflavin,
                vitaminB3_Niacin: v.vitaminB3_Niacin, vitaminB5_PantothenicAcid: v.vitaminB5_PantothenicAcid,
                vitaminB6: v.vitaminB6, vitaminB7_Biotin: v.vitaminB7_Biotin,
                folateDFE: v.folateDFE, folateFood: v.folateFood, folateTotal: v.folateTotal,
                folicAcid: v.folicAcid, vitaminB12: v.vitaminB12, vitaminB12Added: v.vitaminB12Added,
                vitaminC: v.vitaminC, vitaminD: v.vitaminD,
                vitaminE: v.vitaminE, vitaminEAdded: v.vitaminEAdded,
                vitaminK: v.vitaminK, choline: v.choline
            )
            item.vitamins?.foodItem = item
        }

        // 5) Минерали
        if let m = minerals {
            item.minerals = MineralsData(
                calcium: m.calcium, phosphorus: m.phosphorus, magnesium: m.magnesium,
                potassium: m.potassium, sodium: m.sodium, chloride: m.chloride,
                iron: m.iron, zinc: m.zinc, copper: m.copper, manganese: m.manganese,
                selenium: m.selenium, iodine: m.iodine, chromium: m.chromium,
                molybdenum: m.molybdenum, fluoride: m.fluoride
            )
            item.minerals?.foodItem = item
        }

        // 6) Други съединения
        if let o = other {
            item.other = OtherCompoundsData(
                alcoholEthyl: o.alcoholEthyl, caffeine: o.caffeine, theobromine: o.theobromine,
                cholesterol: o.cholesterol, energyKcal: o.energyKcal,
                water: o.water, weightG: o.weightG
            )
            item.other?.foodItem = item
        }

        return item
    }
}


