            tfa22_1_t += f * nv(food.lipids?.tfa22_1_t); tfa18_2_t += f * nv(food.lipids?.tfa18_2_t)

            // PUFA
            pufa18_2 += f * nv(food.lipids?.pufa18_2); pufa18_3 += f * nv(food.lipids?.pufa18_3)
