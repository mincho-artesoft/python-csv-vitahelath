    var body: some View {
        NavigationStack {
            VStack(spacing: 12) {
                // Горен сегмент за избор на домейн
                Picker("Domain", selection: $domain) {
                    ForEach(SearchDomain.allCases) { d in
                        Text(d.rawValue).tag(d)
                    }
