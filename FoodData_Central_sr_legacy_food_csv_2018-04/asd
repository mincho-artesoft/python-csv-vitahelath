    private func setRow(for setBinding: Binding<WorkoutSet>) -> some View {
        let set = setBinding.wrappedValue
        
        return HStack {
            Text("Set \(exerciseLog.sets.firstIndex(where: { $0.id == set.id })! + 1)")
                .font(.subheadline)
                .foregroundStyle(effectManager.currentGlobalAccentColor)
                .frame(width: 50)
            
            Spacer()
            
            // Reps field
            ConfigurableTextField(
                title: "Reps",
                value: repsBinding(for: setBinding),
                type: .integer,
                placeholderColor: effectManager.currentGlobalAccentColor.opacity(0.6),
                textAlignment: .center,
                focused: $focusedField,
                fieldIdentifier: FocusField(exerciseID: exercise.id, setID: set.id)
