    func addFoodItem(_ food: FoodItem) {
        let isImperial = GlobalState.measurementSystem == "Imperial"
        let defaultQuantityInGrams = isImperial ? UnitConversion.ozToG(4.0) : 100.0
        let defaultPrice = lastPrices[food.id]
        withAnimation { list.items.insert(ShoppingListItem(name: food.name, quantity: defaultQuantityInGrams, price: defaultPrice, foodItem: food), at: 0) }
        updateListCompletionStatus()

        dismissKeyboardAndSearch()

        viewModel.fetchAllData()
    }

    func addSuggestedItem(food: FoodItem) {
        let isImperial = GlobalState.measurementSystem == "Imperial"
        let defaultQuantityInGrams = isImperial ? UnitConversion.ozToG(4.0) : 100.0
        let defaultPrice = lastPrices[food.id]
        withAnimation { list.items.insert(ShoppingListItem(name: food.name, quantity: defaultQuantityInGrams, price: defaultPrice, foodItem: food), at: 0) }
        updateListCompletionStatus(); viewModel.fetchAllData()
    }

    func updateSearchExclusions() { searchVM.exclude(Set(list.items.compactMap { $0.foodItem })) }
    func cancelChanges() { hideKeyboard(); if modelContext.hasChanges { if isNew && !hasBeenSaved { modelContext.delete(list) } else { modelContext.rollback() } }; onDismiss() }

    func saveChanges() {
        updateListCompletionStatus()
        hideKeyboard()

        if isNew && !hasBeenSaved { modelContext.insert(list) }

        do { try viewModel.processCompletedItems(for: list, initiallyBoughtIDs: initiallyBoughtItemIDs) }
        catch { print("Грешка при обработка на завършените елементи: \(error)") }

        Task { @MainActor in
            if let oldNotificationID = list.notificationID {
                NotificationManager.shared.cancelNotification(id: oldNotificationID)
                list.notificationID = nil
            }
            if let minutes = list.reminderMinutes, minutes > 0 {
                let reminderDate = list.eventStartDate.addingTimeInterval(-TimeInterval(minutes * 60))
                let timeInterval = reminderDate.timeIntervalSinceNow
                if timeInterval > 0 {
                    do {
                        let newNotificationID = try await NotificationManager.shared.scheduleNotification(title: "🛒 Shopping Reminder", body: "Time to buy groceries for your list: \(list.name)", timeInterval: timeInterval, userInfo: ["shoppingListID": list.id.uuidString])
                        list.notificationID = newNotificationID
                    } catch { print("Грешка при планиране на нотификация: \(error.localizedDescription)") }
                }
            }

            let newEventID = await CalendarViewModel.shared.createOrUpdateShoppingListEvent(
                for: list,
                context: modelContext
            )
            list.calendarEventID = newEventID

            if modelContext.hasChanges {
                do { try modelContext.save() }
                catch { print("Грешка при запис след нотификация/събитие: \(error)") }
            }
        }

        do {
            if modelContext.hasChanges { try modelContext.save() }
            hasBeenSaved = true
            initiallyBoughtItemIDs = Set(list.items.filter { $0.isBought }.map { $0.id })
            viewModel.fetchAllData()

            do {
                let encoded = try JSONEncoder().encode(lastPrices)
                lastPricesData = encoded
            } catch { print("Failed to encode last prices: \(error)") }
        } catch {
            print("Грешка при финален запис на списъка за пазаруване: \(error)")
        }
    }

    private var selectedNutrientItem: SelectableNutrient? {
        guard let id = selectedNutrientID else { return nil }
        return allSelectableNutrients.first { $0.id == id }
    }

    private var filterChipItems: [SelectableNutrient] {
        let profile = viewModel.profile

        let priorityVitIDs = Set(profile.priorityVitamins.map { "vit_" + $0.id })
        let priorityMinIDs = Set(profile.priorityMinerals.map { "min_" + $0.id })
        let allPriorityIDs = priorityVitIDs.union(priorityMinIDs)

        let (priority, other) = allSelectableNutrients.reduce(into: ([SelectableNutrient](), [SelectableNutrient]())) { result, nutrient in
            if allPriorityIDs.contains(nutrient.id) {
                result.0.append(nutrient)
            } else {
                result.1.append(nutrient)
            }
        }

        return priority + other
    }

    private var allSelectableNutrients: [SelectableNutrient] {
        var items: [SelectableNutrient] = []
        items.append(contentsOf: allVitamins.map { SelectableNutrient(id: "vit_\($0.id)", label: $0.abbreviation) })
        items.append(contentsOf: allMinerals.map { SelectableNutrient(id: "min_\($0.id)", label: $0.symbol) })
        return items.sorted { $0.label < $1.label }
    }

    private func nutrientColor(for id: String) -> Color {
        if id.starts(with: "vit_"), let vitamin = allVitamins.first(where: { "vit_\($0.id)" == id }) {
            return Color(hex: vitamin.colorHex)
        }
        if id.starts(with: "min_"), let mineral = allMinerals.first(where: { "min_\($0.id)" == id }) {
            return Color(hex: mineral.colorHex)
        }
        return .gray
    }

    private func syncFilters(with id: String?) {
        searchVM.vitaminFilters.removeAll()
        searchVM.mineralFilters.removeAll()
        guard let id = id else { return }

        if id.hasPrefix("vit_") {
            searchVM.vitaminFilters.insert(String(id.dropFirst(4)))
        }
        if id.hasPrefix("min_") {
            searchVM.mineralFilters.insert(String(id.dropFirst(4)))
        }
    }

    private func reloadLastPricesFromAppStorage() {
        if let decoded = try? JSONDecoder().decode([Int: Double].self, from: lastPricesData) {
            lastPrices = decoded
        } else {
            lastPrices = [:]
        }
    }
}


