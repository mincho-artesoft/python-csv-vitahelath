            }
        }

        let finalValueInGrams = (usesUnitConversion && isImperial) ? UnitConversion.ozToG(parsedDisplayValue) : parsedDisplayValue
        let finalValue = isInteger ? floor(finalValueInGrams) : finalValueInGrams
        
        if value != finalValue {
