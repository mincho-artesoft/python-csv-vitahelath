            return Color(hex: vitamin.colorHex)
        }
        if id.starts(with: "min_"), let mineral = allMinerals.first(where: { "min_\($0.id)" == id }) {
            return Color(hex: mineral.colorHex)
        }
        return .gray
    }
    
