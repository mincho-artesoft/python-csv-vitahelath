        inDietVM.selectedNutrientID = nil
        inDietVM.showRecipesOnly = false
        inDietVM.showMenusOnly   = false
        inDietVM.profileAgeInMonths = nil
        inDietVM.setDietFilters([]) // празно – да не зарежда от БД
        inDietVM.setItems(to: stagingFoods)
        
        // overlay search VM (каталог)
        searchVM.attach(context: modelContext)
        searchVM.searchContext = .none
        searchVM.isFavoritesModeActive = false
        searchVM.selectedNutrientID = nil
        searchVM.showRecipesOnly = false
        searchVM.showMenusOnly   = false
        searchVM.profileAgeInMonths = nil
        searchVM.setDietFilters([])
        searchVM.onlyUserAdded = isDefaultDiet   // ограничение при default edit
        
        // синхронизирай началния текст и изключи вече добавените от staging
        searchVM.query = globalSearchText
        updateSearchExclusions()
    }
    
