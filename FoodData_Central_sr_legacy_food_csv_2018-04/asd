                    .frame(maxWidth: .infinity, alignment: .leading)   // <- важното
                    .contentShape(Rectangle())                         // цялата ширина да е tappable
                    .onTapGesture {
                        withAnimation(.spring()) {
                            if selectedFoodIDs.contains(food.id) {
