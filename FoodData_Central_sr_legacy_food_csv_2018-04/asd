            sfa22_0: n(sfa22,"g"), sfa24_0: n(sfa24,"g"),
            mufa14_1: n(mufa14_1,"g"), mufa15_1: n(mufa15_1,"g"), mufa16_1: n(mufa16_1,"g"),
            mufa17_1: n(mufa17_1,"g"), mufa18_1: n(mufa18_1,"g"), mufa20_1: n(mufa20_1,"g"),
