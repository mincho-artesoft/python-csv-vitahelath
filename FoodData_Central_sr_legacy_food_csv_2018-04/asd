    // MARK: – Exercises ------------------------------------------------------
    private static func seedExercisesIfNeeded(context ctx: ModelContext) async {
        print("-> Checking for Exercises...")
        guard databaseIsEmpty(entity: ExerciseItem.self, context: ctx) else {
            print("   Exercises already seeded, skipping.")
            return
        }

        print("   Seeding Exercises from sports.json...")
        guard let url = Bundle.main.url(forResource: "sports", withExtension: "json") else {
            assertionFailure("sports.json not found"); return
        }

        do {
            let raw = try Data(contentsOf: url)
            let dtos = try JSONDecoder().decode([ExerciseItemDTO].self, from: raw)
            print("   - Decoded \(dtos.count) exercise DTOs from JSON.")

            try ctx.transaction {
                for dto in dtos {
                    let exercise = dto.model()
                    ctx.insert(exercise)
                }
            }
            print("   ✅ Seeded \(dtos.count) exercises from sports.json")

            // 📊 Stats
            let allSeededExercises = try ctx.fetch(FetchDescriptor<ExerciseItem>())

            var sportCounts: [Sport: Int] = Dictionary(uniqueKeysWithValues: Sport.allCases.map { ($0, 0) })
            for exercise in allSeededExercises {
                if let sports = exercise.sports {
                    for sport in sports {
                        sportCounts[sport, default: 0] += 1
                    }
                }
            }

            print("   📊 Exercise count per sport after seeding:")
            for (sport, count) in sportCounts.sorted(by: { $0.key.rawValue < $1.key.rawValue }) {
                print("      - \(sport.rawValue): \(count) exercises")
            }

            var muscleCounts: [MuscleGroup: Int] = Dictionary(uniqueKeysWithValues: MuscleGroup.allCases.map { ($0, 0) })
            for exercise in allSeededExercises {
                for muscle in exercise.muscleGroups {
                    muscleCounts[muscle, default: 0] += 1
                }
            }

            print("   💪 Exercise count per muscle group after seeding:")
            for (muscle, count) in muscleCounts.sorted(by: { $0.key.rawValue < $1.key.rawValue }) {
                print("      - \(muscle.rawValue): \(count) exercises")
            }

        } catch {
            print("   ❌ Exercise seeding failed: \(error)")
        }
    }

