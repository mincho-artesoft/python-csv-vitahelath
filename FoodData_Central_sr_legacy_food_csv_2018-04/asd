    // MARK: - Index cleanup for deleted FoodItem
    private func cleanupIndexes(for foodID: Int) {
        guard let ctx = context else { return }
        
        do {
            // 1) Изтриваме всички IndexingJob за тази храна
            let jobDesc = FetchDescriptor<IndexingJob>(
                predicate: #Predicate { $0.foodID == foodID }
            )
            let jobs = try ctx.fetch(jobDesc)
            jobs.forEach { ctx.delete($0) }
            
            // 2) Премахваме я от NameIndex
            let nameDesc = FetchDescriptor<NameIndex>()
            if let nameIndex = try ctx.fetch(nameDesc).first {
                nameIndex.entries.removeAll { $0.foodID == foodID }
            }
            
            // 3) Премахваме я от всички NutrientIndex
            let nutrientDesc = FetchDescriptor<NutrientIndex>()
