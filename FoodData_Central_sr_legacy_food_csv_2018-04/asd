import Foundation

extension String {
    func nilIfEmpty() -> String? { isEmpty ? nil : self }
    
    var foldedSearchKey: String {
        self.folding(options: [.diacriticInsensitive, .caseInsensitive], locale: .current)
            .lowercased()
    }
    
    var _normKey: String {
            self.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        }
    
    func levenshteinDistance(to: String) -> Int {
        let s1 = Array(self.lowercased()), s2 = Array(to.lowercased())
        let s1_len = s1.count, s2_len = s2.count
        if s1_len == 0 { return s2_len }
        if s2_len == 0 { return s1_len }
        var matrix = [[Int]](repeating: [Int](repeating: 0, count: s2_len + 1), count: s1_len + 1)
        for i in 0...s1_len { matrix[i][0] = i }
        for j in 0...s2_len { matrix[0][j] = j }
        for i in 1...s1_len {
            for j in 1...s2_len {
                let cost = (s1[i - 1] == s2[j - 1]) ? 0 : 1
                matrix[i][j] = Swift.min(matrix[i - 1][j] + 1, matrix[i][j - 1] + 1, matrix[i - 1][j - 1] + cost)
            }
        }
        return matrix[s1_len][s2_len]
    }
    

    func ifEmpty(_ replacement: String) -> String { self.isEmpty ? replacement : self }
    
    /// Строгият вариант: всеки символ, който НЕ е [A-Za-z0-9], се заменя с "_".
    /// НЕ свива поредици. Запазва големите/малки букви. Примери:
    /// "A, b" -> "A__b"
    /// "name)" -> "name_"
    func assetKeyStrict() -> String {
        return self.unicodeScalars.map { scalar in
            if CharacterSet.alphanumerics.contains(scalar) {
                return String(scalar)
            } else {
                return "_"
            }
        }.joined()
    }

    /// По-"чист" вариант: заменяме не-алфанумерични с "_", след това
    /// свиваме поредици от "_" до един и премахваме водещи/последни "_".
    func assetKeyCollapsed() -> String {
        let replaced = self.unicodeScalars.map { scalar in
            CharacterSet.alphanumerics.contains(scalar) ? String(scalar) : "_"
        }.joined()

        // Свиване на поредици от "_" до един
        let collapsed = replaced.replacingOccurrences(of: "_+", with: "_", options: .regularExpression)
        // Премахване на водещи/последни "_"
        return collapsed.trimmingCharacters(in: CharacterSet(charactersIn: "_"))
    }
}


