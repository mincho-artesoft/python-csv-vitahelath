            RootView()
                .modelContainer(container)
                .opacity(isSeeding ? 0 : 1)

            // ПРОМЯНА: Стилизираме изгледа за зареждане
            if isSeeding {
                // 1. Използваме същия фон като в LoginView и останалата част от приложението
                ThemeBackgroundView()
                    .ignoresSafeArea()
                    .transition(.opacity.animation(.easeInOut)) // Плавна поява

