    func delete(_ item: FoodItem) {
        guard item.isUserAdded, let ctx = context else { return }
        
        let foodID = item.id
        
        // 1) Първо махаме реда от UI-а, за да не се опитва SwiftUI
        //    да рендерира FoodItemRowView с вече изтрит модел.
        if let index = items.firstIndex(of: item) {
            items.remove(at: index)
        }
        
        // 2) Изчакваме един цикъл на runloop-а, за да може
        //    List/ForEach да се обнови и редът да изчезне визуално,
        //    и чак след това трия от SwiftData.
        DispatchQueue.main.async { [weak self, weak item] in
            guard let self,
                  let ctx = self.context,
                  let item = item
            else { return }
            
            // Ако междувременно вече е изтрит от друг контекст – просто излизаме
            if item.modelContext == nil { return }
            
            // --- логика за менюта (запазваме твоя код) ---
            if item.isMenu {
                print("🗑️ Deleting a menu item: \(item.name). Checking for linked meal plans...")
                
                let menuIDToDelete = item.id
                let descriptor = FetchDescriptor<MealPlanMeal>(
                    predicate: #Predicate { $0.linkedMenuID == menuIDToDelete }
                )
                
                do {
                    let linkedMeals = try ctx.fetch(descriptor)
                    
                    if !linkedMeals.isEmpty {
                        print("   - Found \(linkedMeals.count) meal plan slots linked to this menu. Clearing them.")
                        for meal in linkedMeals {
                            for entry in meal.entries {
                                ctx.delete(entry)
                            }
                            meal.entries.removeAll()
                            meal.linkedMenuID = nil
                        }
                    } else {
                        print("   - No meal plan slots are linked to this menu.")
                    }
                } catch {
                    print("   - ❌ Failed to fetch linked meal plan meals: \(error)")
                }
            }
            // --- край на логиката за меню ---
            
            // 3) Чистим RecentlyAddedFood / DismissedFoodID / ShoppingListItem за тази храна
            self.cleanupShoppingMetadata(for: item)
            
            // 4) Чистим индексите (NutrientIndex, NameIndex, IndexingJob)
            self.cleanupIndexes(for: foodID)
            
            // 5) Нулираме „тежките“ релации, за всеки случай
            item.macronutrients = nil
            item.lipids         = nil
            item.vitamins       = nil
            item.minerals       = nil
            item.other          = nil
            item.aminoAcids     = nil
            item.carbDetails    = nil
            item.sterols        = nil
            
            // 6) И накрая трием самия FoodItem
            ctx.delete(item)
            
            do {
                try ctx.save()
            } catch {
                print("❌ Failed to save context after deleting food '\(item.name)': \(error)")
            }
        }
    }

    
