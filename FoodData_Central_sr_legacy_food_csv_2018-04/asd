import SwiftUI

/// Един пръстен + 0-2-редов етикет с фиксирана височина,
/// така че **всички клетки** да са еднакви.
struct NutrientRingView: View {
    @ObservedObject private var effectManager = EffectManager.shared

    // MARK: – INPUT
    let item: NutriItem
    var diameter:   CGFloat = 70         // Ø на пръстена
    var isSelected: Bool    = false
    
    // MARK: – Geometry
    private var ringWidth:    CGFloat { diameter * 0.11 }
    private let labelSpacing: CGFloat = 6                // между кръг и текст

    private var labelFontSize: CGFloat { diameter * 0.22 }
    private let labelLines:    Int     = 2               // макс. редове

    /// Височината, която НИКОГА няма да надвишаваме
    private var labelHeight: CGFloat {
        labelFontSize * 1.25 * CGFloat(labelLines)
    }

    private var totalHeight: CGFloat {
        diameter + labelSpacing + labelHeight
    }

    // MARK: – Progress & colouring
    
    // Базата за 100% винаги е dailyNeed.
    private var denominator: Double? { item.dailyNeed }

    /// Изчислява колко от пръстена да се оцвети (ограничено до 100%).
    private var progress: Double {
        guard let denom = denominator, denom > 0 else { return 1 }
        return min(item.amount / denom, 1)
    }

    /// Процент за показване:
    /// • Под dailyNeed показва реалния % (напр. 75).
    /// • Над или равно на dailyNeed, показва точно 100.
    private var percent: Int {
        guard let dn = item.dailyNeed, dn > 0 else {
            return 100 // Ако няма дневна нужда, показваме 100% по подразбиране.
        }
        
        // Ако сме достигнали или надминали дневната нужда,
        // показваме 100%. В противен случай, изчисляваме реалния процент.
        if item.amount >= dn {
            return 100
        } else {
            return Int((item.amount / dn) * 100)
        }
    }

    /// Цвят според amount:
    /// • червено – под dailyNeed
    /// • зелено  – между dailyNeed и upperLimit
    /// • червено – над/равно на upperLimit
    private var percentColor: Color {
        // 1. Проверка за горна граница (upperLimit) - най-висок приоритет
        if let ul = item.upperLimit, item.amount >= ul {
            return .red // Надвишили сме UL -> червено
        }
        
        // 2. Проверка за дневна нужда (dailyNeed)
        if let dn = item.dailyNeed, dn > 0 {
            // Цветът зависи само от това дали сме над или под DN.
            return item.amount >= dn ? .green : .red
        }
        
        // 3. Ако няма нито DN, нито UL, използваме системен цвят
        return effectManager.currentGlobalAccentColor
    }

    // MARK: – init
    init(item: NutriItem,
         diameter: CGFloat = 70,
         isSelected: Bool = false) {
        self.item       = item
        self.diameter   = diameter
        self.isSelected = isSelected
    }

    // MARK: – BODY
    var body: some View {
        VStack(spacing: labelSpacing) {

            // ––– Кръгът –––
            ZStack {
                Circle()
                    .stroke(effectManager.currentGlobalAccentColor.opacity(0.2),
                            lineWidth: ringWidth)
                    .shadow(color: .white.opacity(0.7),  radius: 1, x: -1, y: -1)
                    .shadow(color: .black.opacity(0.15), radius: 2, x:  2, y:  2)
                Circle()
                    .trim(from: 0, to: progress)
                    .stroke(item.color,
                            style: .init(lineWidth: ringWidth,
                                         lineCap: .round))
                    .rotationEffect(.degrees(-90))

                Text("\(percent)%")
                    .font(.system(size: diameter * 0.24,
                                  weight: .bold,
                                  design: .rounded))
                    .foregroundColor(percentColor)
            }
            .frame(width: diameter, height: diameter)
            .animation(.easeInOut(duration: 0.5), value: progress)
            // ––– Етикет –––
            Text(item.label)
                .font(.system(size: labelFontSize,
                              weight: .semibold,
                              design: .rounded))
                .frame(width:  diameter,
                       height: labelHeight,           // фиксирана височина
                       alignment: .top)
                .foregroundStyle(effectManager.currentGlobalAccentColor)
                .multilineTextAlignment(.center)
                .lineLimit(labelLines)
                .minimumScaleFactor(0.7)              // свива текста при нужда
        }
        .frame(width: diameter,
               height: totalHeight,
               alignment: .top)
        .padding(6)
        .glassCardStyle(cornerRadius: 15)
        .overlay(
            RoundedRectangle(cornerRadius: 15)
                .stroke(isSelected ? item.color.opacity(0.7)
                                   : effectManager.currentGlobalAccentColor.opacity(0),
                        lineWidth: 2)
        )
        
    }
}


