    ) {
        // --- Y grid + labels ---
        for value in yAxisLabels {
            let yPos = yPosition(for: value, inYRange: yRange, graphHeight: graphSize.height, originY: origin.y)

            var path = Path()
            path.move(to: CGPoint(x: origin.x, y: yPos))
