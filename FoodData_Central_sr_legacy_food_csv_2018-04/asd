import SwiftUI

// MARK: – UIKit wrapper за ЧИСТ compact UIDatePicker
struct ClearDatePicker: UIViewRepresentable {
    @Binding var date: Date
    var displayedComponents: DatePickerComponents = .date        // .date by default

    // ─────────── UIViewRepresentable
    func makeUIView(context: Context) -> UIDatePicker {
        let picker = UIDatePicker()
        picker.date = date
        picker.datePickerMode = displayedComponents == .date ? .date : .dateAndTime
        picker.preferredDatePickerStyle = .compact

        // премахваме фона
        clearBackground(of: picker)

        picker.addTarget(
            context.coordinator,
            action: #selector(Coordinator.dateChanged(_:)),
            for: .valueChanged
        )
        return picker
    }

    func updateUIView(_ uiView: UIDatePicker, context: Context) {
        if uiView.date != date {
            uiView.date = date
        }
        clearBackground(of: uiView)   // подсигуряваме, че не се връща фон
    }

    // ─────────── Coordinator
    func makeCoordinator() -> Coordinator { Coordinator(parent: self) }
    
    class Coordinator: NSObject {
        var parent: ClearDatePicker
        init(parent: ClearDatePicker) { self.parent = parent }
        
        @MainActor @objc func dateChanged(_ sender: UIDatePicker) {
            parent.date = sender.date
            // <<< КОРЕКЦИЯТА Е ТУК
            // Казваме на пикъра да се откаже от фокуса, което затваря попоувъра
            sender.resignFirstResponder()
        }
    }

    // ─────────── helper
    private func clearBackground(of picker: UIDatePicker) {
        picker.backgroundColor = .clear
        // вътрешната капсула е дълбока ~2 subviews, затова минаваме рекурсивно
        func recurse(_ view: UIView) {
            view.backgroundColor = .clear
            view.subviews.forEach(recurse)
        }
        recurse(picker)
    }
}


