        self.calculatedMinAge = requiredMinAge

        let currentUserAge = Int(minAgeMonthsTxt) ?? 0

        if currentUserAge < requiredMinAge || (minAgeMonthsTxt.isEmpty && requiredMinAge > 0) {
            minAgeMonthsTxt = String(requiredMinAge)
