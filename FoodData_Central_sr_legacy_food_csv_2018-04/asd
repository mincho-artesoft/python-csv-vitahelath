        // Values are intentionally conservative and should be replaced with your BabyData if available.
        typealias R = (min: Double, max: Double)
        let fallbackAnchors: [Int: R]
        switch metric {
        case .height:
            // centimeters
            fallbackAnchors = [
                0:  (45, 55),
                1:  (49, 58),
                3:  (54, 64),
                6:  (60, 72),
                9:  (65, 76),
                12: (70, 82),
                18: (77, 89),
