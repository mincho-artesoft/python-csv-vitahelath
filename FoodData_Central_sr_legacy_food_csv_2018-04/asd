            .frame(maxWidth: .infinity, alignment: .leading)
            
            Spacer(minLength: 8)
            
            HStack(spacing: 4) {
                ConfigurableTextField(
                    title: ingredientUnit,
                    value: $textValue,
                    type: .decimal,
