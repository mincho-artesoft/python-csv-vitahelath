                 print("   ⚠️ [Attempt \(attempt)] Calendar not found. It might already be deleted.")
                 return
            }
            if attempt < maxRetries {
                try? await Task.sleep(for: retryDelay)
            }
        }
        print("   ❌ Failed to definitively delete calendar with id '\(id)' after \(maxRetries) attempts.")
    }
    
