        }
    }

    // MARK: - Nutrient Indexes ----------------------------------------------
    private static func seedNutrientIndexesIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: NutrientIndex.self, context: ctx) else { return }

        do {
            let vitamins = try ctx.fetch(FetchDescriptor<Vitamin>())
            let minerals = try ctx.fetch(FetchDescriptor<Mineral>())
            let allNutrientIDs = vitamins.map { "vit_\($0.id)" } + minerals.map { "min_\($0.id)" }

            let allFoods = try ctx.fetch(FetchDescriptor<FoodItem>())

            for nutrientID in allNutrientIDs {
                var rankings: [FoodRank] = []
                rankings.reserveCapacity(max(8, allFoods.count / 10))

                for food in allFoods {
                    if let (value, unit) = food.value(of: nutrientID), value > 0 {
                        let valueInMg = toMg(value: value, unit: unit)
                        rankings.append(.init(
                            foodID: food.id,
                            value: valueInMg,
                            nameKey: food.nameNormalized
                        ))
                    }
                }

                if rankings.isEmpty { continue }
                rankings.sort { $0.value > $1.value }

                let index = NutrientIndex(nutrientID: nutrientID, rankedFoods: rankings)
                ctx.insert(index)
            }

            print("   ✅ Seeded \(allNutrientIDs.count) nutrient indexes.")
        } catch {
            print("   ❌ Nutrient index seeding failed: \(error)")
        }
    }

    // MARK: - Name Index -----------------------------------------------------
    private static func seedNameIndexIfNeeded(context ctx: ModelContext) async {
        guard databaseIsEmpty(entity: NameIndex.self, context: ctx) else { return }
        do {
            let allFoods = try ctx.fetch(FetchDescriptor<FoodItem>())
            let entries: [NameEntry] = allFoods.map { .init(foodID: $0.id, nameKey: $0.nameNormalized) }
            let ix = NameIndex(entries: entries)
            ctx.insert(ix)
            print("   ✅ Seeded name index with \(entries.count) entries.")
        } catch {
            print("   ❌ Name index seeding failed: \(error)")
        }
    }

    // MARK: – Helper ---------------------------------------------------------
    private static func databaseIsEmpty<T: PersistentModel>(
        entity: T.Type,
        context ctx: ModelContext
    ) -> Bool {
        ((try? ctx.fetchCount(FetchDescriptor<T>())) ?? 0) == 0
    }

    private static func toMg(value: Double, unit: String) -> Double {
        switch unit.lowercased() {
        case "g":            return value * 1_000
        case "µg", "mcg":    return value * 0.001
        default:             return value
        }
    }
}


