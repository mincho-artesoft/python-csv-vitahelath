        muscleGroups: [MuscleGroup], sports: [Sport]? = nil, durationMinutes: Int? = nil,
        isWorkout: Bool = false, exercises: [ExerciseLinkCopy]? = nil, minimalAgeMonths: Int = 0
    ) {
