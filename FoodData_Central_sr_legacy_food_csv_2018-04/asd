    // MARK: - Logic & Actions
    private func save() {
           // 1. Вземаме или създаваме обекта в паметта, БЕЗ да го вмъкваме в контекста все още.
           let item: FoodItem
           if let existingFood = food {
               item = existingFood
           } else {
               // Създаваме напълно нов обект, който все още не е част от базата данни.
               let nextID = (try? ctx.fetchCount(FetchDescriptor<FoodItem>())) ?? 0
               item = FoodItem(id: nextID + 1, name: name, isRecipe: false, isMenu: true, isUserAdded: true)
           }
       
           // 2. Попълваме всички свойства на обекта (нов или съществуващ).
           item.name = name
           item.photo = photoData
           item.itemDescription = itemDescription.trimmingCharacters(in: .whitespacesAndNewlines).nilIfEmpty()
           item.prepTimeMinutes = Int(prepTimeTxt)
           
           item.category  = idsToEnums(selectedCategories, of: FoodCategory.self)
           item.diets     = idsToEnums(selectedDiets,      of: Diet.self)
           item.allergens = idsToEnums(selectedAllergens,  of: Allergen.self)
           
           item.isRecipe     = false
           item.isMenu       = true
           item.isUserAdded  = true
       
           if item.gallery == nil { item.gallery = [] }
           item.gallery?.removeAll { photo in !galleryData.contains(photo.data) }
           for data in galleryData {
               if !(item.gallery?.contains(where: { $0.data == data }) ?? false) {
                   item.gallery?.append(FoodPhoto(data: data))
               }
           }
       
           // 3. Управляваме връзките към съставките.
           // Първо изтриваме старите връзки, ако редактираме съществуващ обект.
           if let existingLinks = item.ingredients {
               for link in existingLinks {
                   ctx.delete(link)
               }
           }
           item.ingredients = [] // Нулираме масива
       
           // Създаваме новите връзки в паметта и ги свързваме с нашия `item`.
           let newLinks = selectedIng.compactMap { (foodItem, grams) -> IngredientLink? in
               guard grams > 0 else { return nil }
               // Този IngredientLink също е само в паметта засега.
               return IngredientLink(food: foodItem, grams: grams, owner: item)
           }
           item.ingredients = newLinks
       
           // 4. Финална стъпка: вмъкваме и запазваме.
           do {
               // Ако е бил НОВ обект, го вмъкваме в контекста ЧАК СЕГА.
               // SwiftData е достатъчно умен, за да вмъкне и свързаните `newLinks` автоматично (заради cascade правилото).
               if food == nil {
                   ctx.insert(item)
               }
               
               try ctx.save() // Запазваме всички промени (обновяване или ново вмъкване).
               // --- NEW: Trigger re-indexing in the background ---
               Task {
                   await IndexingManager.updateIndexes(for: item, context: ctx)
               }
               onDismiss()    // Затваряме изгледа само при успех.
           }
           catch {
               alertMsg = error.localizedDescription
               showAlert = true
           }
       }
    
    private func loadFromDubFood() async {
        guard let copy = dubFood else { return }
        
        let original = copy.toOriginal(in: ctx)
        await MainActor.run {
            origRecipe    = original
            name          = "Copy of \(copy.name)"
            photoData     = copy.photo
            itemDescription = copy.itemDescription ?? ""
            prepTimeTxt   = copy.prepTimeMinutes.map { String($0) } ?? ""
            
            if let links = original.ingredients {
                let pairs = links.compactMap { link -> (FoodItem, Double)? in
                    guard let food = link.food else { return nil }
                    return (food, link.grams)
                }
                selectedIng = Dictionary(grouping: pairs, by: { $0.0 })
                    .mapValues { $0.reduce(0.0) { $0 + $1.1 } }
            }
            
            recalcTotals()
            recalcTags()
            
            galleryData = copy.gallery?.map(\.data) ?? []
        }
    }

