    private func splitAllDay(_ evts: [EventDescriptor]) -> ([EventDescriptor], [EventDescriptor]) {
        var allDay: [EventDescriptor] = []
        var regular: [EventDescriptor] = []
        for e in evts {
            e.isAllDay ? allDay.append(e) : regular.append(e)
        }
        return (allDay, regular)
