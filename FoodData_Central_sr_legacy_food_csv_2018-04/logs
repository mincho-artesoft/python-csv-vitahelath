    // Post-processing: Enforce component limits and drop condiments/herbs per meal.
    private func enforceComponentLimits(plan: AIConceptualPlanResponse, onLog: (@Sendable (String) -> Void)?) -> AIConceptualPlanResponse {
        func isCondiment(_ n: String) -> Bool {
            let l = n.lowercased()
            let keys = ["ketchup","mustard","mayo","mayonnaise","aioli","dressing","sauce","butter","ghee","cream","whipped","lemon","lime","basil","oregano","parsley","cilantro","coriander","ginger","garlic","turmeric","paprika","chili","pepper","spice","herb"]
            if keys.contains(where: { l.contains($0) }) { return true }
            // NEW: treat generic forms as condiments without naming specific foods
            if l.contains(" paste") || l.hasSuffix(" paste") { return true }
            if l.contains(" spread") || l.hasSuffix(" spread") { return true }
            return false
        }
        func isIndianStyle(meal: ConceptualMeal) -> Bool {
            let hay = (meal.descriptiveTitle + " " + meal.name + " " + meal.components.map { $0.name }.joined(separator: " ")).lowercased()
            let keys = ["curry","dal","masala","thali","roti","chapati","biryani","sambar","dosa","idli"]
            return keys.contains { hay.contains($0) }
        }
        func rank(_ name: String) -> Int {
            let l = name.lowercased()
            if l.contains("chicken") || l.contains("fish") || l.contains("beef") || l.contains("pork") || l.contains("tofu") || l.contains("tempeh") || l.contains("egg") || l.contains("lentil") || l.contains("bean") { return 0 }
            if l.contains("rice") || l.contains("bread") || l.contains("pasta") || l.contains("quinoa") || l.contains("oat") || l.contains("potato") { return 1 }
            if l.contains("salad") || l.contains("broccoli") || l.contains("pepper") || l.contains("tomato") || l.contains("spinach") || l.contains("zucchini") || l.contains("cauliflower") { return 2 }
            if l.contains("yogurt") || l.contains("milk") || l.contains("cheese") { return 3 }
            if l.contains("fruit") || l.contains("apple") || l.contains("banana") || l.contains("berries") || l.contains("blueberries") { return 4 }
            return 5
        }

        var out = plan
        for d in 0..<out.days.count {
            for m in 0..<out.days[d].meals.count {
                var meal = out.days[d].meals[m]
                let maxCount = isIndianStyle(meal: meal) ? 10 : 5
                var comps = meal.components.filter { !isCondiment($0.name) }
                if comps.count > maxCount {
                    comps.sort { (a, b) in rank(a.name) < rank(b.name) }
                    comps = Array(comps.prefix(maxCount))
                    meal.components = comps
                    out.days[d].meals[m] = meal
                    onLog?("   -> Trimmed components for '\(meal.name)' to \(maxCount).")
                }
            }
        }
        return out
    }

    // Utility: Creates a signature for a meal for duplicate detection.
    private func mealSignature(_ meal: ConceptualMeal) -> String {
        let names = meal.components.map { $0.name.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() }
        return names.sorted().joined(separator: "|")
    }

    // Inter-day variety enforcer to reduce identical meals across days.
        @MainActor
        private func enforceInterDayVariety(
            plan: AIConceptualPlanResponse,
            daysAndMeals: [Int: [String]],
            includedFoods: [String],
            mustContainRules: [MustContainRule],
            excludedFoods: [String],
            foodPalette: [String],
            onLog: (@Sendable (String) -> Void)?
        ) async -> AIConceptualPlanResponse {
            var out = plan
            guard out.days.count > 1 else { return out }
            // Ensure meal names are normalized to requested structure before variety checks
            out = normalizeMealsToRequestedOrder(plan: out, daysAndMeals: daysAndMeals, onLog: onLog)

            onLog?("🔎 Inter-day variety pass: scanning for duplicate meals across days…")

            var protectedByDayMeal: [Int: [String: Set<String>]] = [:]
            for r in mustContainRules {
                let keyMeal = (r.meal?.lowercased()) ?? "*"
                var meals = protectedByDayMeal[r.day] ?? [:]
                var set = meals[keyMeal] ?? Set()
                set.insert(r.topic.lowercased())
                meals[keyMeal] = set
                protectedByDayMeal[r.day] = meals
            }
            func isProtected(_ compName: String, day: Int, mealName: String) -> Bool {
                let lower = compName.lowercased()
                let byMeal = protectedByDayMeal[day] ?? [:]
                let mealSet = byMeal[mealName.lowercased()] ?? Set()
                let genericSet = byMeal["*"] ?? Set()
                return mealSet.contains { lower.contains($0) } || genericSet.contains { lower.contains($0) }
            }

            let bannedSet = Set(excludedFoods.map { $0.lowercased() })
            func violatesExcluded(_ n: String) -> Bool { bannedSet.contains { n.lowercased().contains($0) } }

            func indexOfMainComponent(in meal: ConceptualMeal) -> Int? {
                let candidates = meal.components.enumerated().filter { $0.element.grams >= 90 }
                return candidates.max(by: { $0.element.grams < $1.element.grams })?.offset
            }

            var seen: [String: Set<String>] = [:]

            for dIdx in 0..<out.days.count {
                for mIdx in 0..<out.days[dIdx].meals.count {
                    var meal = out.days[dIdx].meals[mIdx]
                    let key = meal.name
                    let sig = mealSignature(meal)

                    if seen[key, default: []].contains(sig) {
                        let mainIdx = indexOfMainComponent(in: meal)
                        var mainComponentChanged = false

                        // Step 1: Try to vary the main component, if it's not protected.
                        if let mainIdx = mainIdx {
                            let currentMain = meal.components[mainIdx].name
                            if isProtected(currentMain, day: out.days[dIdx].day, mealName: meal.name) {
                                onLog?("🔒 Preserved protected main in Day \(out.days[dIdx].day) • \(meal.name): '\(currentMain)'.")
                            } else {
                                let variants = await aiGenerateVariants(for: currentMain, count: 3, mealName: meal.name, excludedFoods: excludedFoods, onLog: onLog)
                                if let replacement = variants.first(where: { v in let lv = v.lowercased(); return lv != currentMain.lowercased() && !violatesExcluded(lv) }) {
                                    meal.components[mainIdx].name = replacement
                                    mainComponentChanged = true
                                    onLog?("🔀 Varied Day \(out.days[dIdx].day) • \(meal.name): main ‘\(currentMain)’ → ‘\(replacement)’.")
                                }
                            }
                        }

                        // Step 2: If the main was protected or couldn't be varied, try to vary a SIDE component.
                        if !mainComponentChanged {
                            let proteinKeys = ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","egg","tofu","tempeh","lentil","bean"]

                            // Find the index of a component that is NOT the main course and is NOT protected.
                            if let sideIdx = meal.components.indices.first(where: { idx in
                                guard idx != mainIdx else { return false } // CRITICAL: Do not replace the main component
                                let comp = meal.components[idx]
                                return !isProtected(comp.name, day: out.days[dIdx].day, mealName: meal.name)
                            }) {
                                let existingSideName = meal.components[sideIdx].name
                                let existingComponents = Set(meal.components.map { $0.name.lowercased() })

                                // Find a suitable replacement from the palette that isn't already in the meal.
                                if let altSide = foodPalette.first(where: { cand in !existingComponents.contains(cand.lowercased()) && !violatesExcluded(cand) }) {
                                    meal.components[sideIdx].name = altSide
                                    onLog?("🔁 Rotated side in Day \(out.days[dIdx].day) • \(meal.name): ‘\(existingSideName)’ → ‘\(altSide)’.")
                                }
                            } else {
                                 onLog?("🔒 No non-protected side available to rotate in Day \(out.days[dIdx].day) • \(meal.name).")
                            }
                        }
                        // --- START OF STEP 3 FALLBACK ---
                        // If the meal signature is STILL identical after trying to vary main/side,
                        // force a side rotation using any candidate from the provided foodPalette
                        // or mined DB options that isn't already present. This guarantees a changed signature.
                        let sigAfterStep2 = mealSignature(meal)
                        if sigAfterStep2 == sig {
                            // Build a broad side candidate set (salads/fruits/veg) from the palette first.
                            func isLightSide(_ n: String) -> Bool {
                                let l = n.lowercased()
                                return l.contains("salad") || l.contains("greens") ||
                                       l.contains("fruit") || l.contains("vegetable") || l.contains("veggies") ||
                                       l.contains("cucumber") || l.contains("tomato") || l.contains("carrot") || l.contains("broccoli")
                            }
                            var sidePool: [String] = []
                            for item in foodPalette {
                                let l = item.lowercased()
                                if isLightSide(l) && !violatesExcluded(l) { sidePool.append(item) }
                            }
                            // If palette is too small, mine DB quickly (cheap scan) for common sides.
                            if sidePool.count < 3 {
                                let ctx = ModelContext(self.container)
                                let descriptor = FetchDescriptor<FoodItem>()
                                if let all = try? ctx.fetch(descriptor) {
                                    for f in all {
                                        let l = f.name.lowercased()
                                        if isLightSide(l) && !violatesExcluded(l) {
                                            sidePool.append(f.name)
                                        }
                                        if sidePool.count >= 12 { break }
                                    }
                                }
                                var dedup = Set<String>()
                                sidePool = sidePool.filter { dedup.insert($0.lowercased()).inserted }
                            }
                            // Pick a replacement slot: prefer beverages/condiments first to avoid breaking mains.
                            let beverageLike = ["coffee","tea","brandy","juice","lemonade","smoothie","latte","milk","water"]
                            let candidateReplaceIdx = meal.components.firstIndex(where: { comp in
                                let l = comp.name.lowercased()
                                // skip protected and the main component if any
                                if let m = mainIdx, meal.components.indices.contains(m), comp.name == meal.components[m].name { return false }
                                if isProtected(comp.name, day: out.days[dIdx].day, mealName: meal.name) { return false }
                                // prefer beverage/condiment-like or obvious small sides
                                return beverageLike.contains(where: { l.contains($0) }) ||
                                       l.contains("dressing") || l.contains("sauce") ||
                                       l.contains("strudel") || l.contains("roll") ||
                                       l.contains("dumpling") || l.contains("vada")
                            }) ?? meal.components.firstIndex(where: { comp in
                                // fall back to *any* non-protected, non-main component
                                if let m = mainIdx, meal.components.indices.contains(m), comp.name == meal.components[m].name { return false }
                                return !isProtected(comp.name, day: out.days[dIdx].day, mealName: meal.name)
                            })
                            if let replIdx = candidateReplaceIdx {
                                // choose a side not already present
                                let existing = Set(meal.components.map { $0.name.lowercased() })
                                if let newSide = sidePool.first(where: { !existing.contains($0.lowercased()) }) {
                                    meal.components[replIdx].name = newSide
                                    meal.components[replIdx].grams = max(90.0, min(meal.components[replIdx].grams, 150.0))
                                    onLog?("🛠️ Forced side rotation to break duplicate in Day \(out.days[dIdx].day) • \(meal.name): replaced '\(existing.first(where: { meal.components[replIdx].name.lowercased() == $0 }) ?? "side")' → '\(newSide)'.")
                                } else {
                                    // As a last resort, rename the descriptive title to indicate variation (signature stays same, but at least UI differs).
                                    let newTitle: String
                                    if meal.descriptiveTitle.isEmpty {
                                        newTitle = "\(meal.name) — variation"
                                    } else if !meal.descriptiveTitle.lowercased().contains("variation") {
                                        newTitle = meal.descriptiveTitle + " (variation)"
                                    } else {
                                        newTitle = meal.descriptiveTitle
                                    }
                                    meal = ConceptualMeal(name: meal.name, descriptiveTitle: newTitle, components: meal.components)
                                    onLog?("ℹ️ No side candidates found to break duplicate; adjusted title for Day \(out.days[dIdx].day) • \(meal.name).")
                                }
                            } else {
                                onLog?("ℹ️ Could not locate a safe component to rotate in Day \(out.days[dIdx].day) • \(meal.name).")
                            }
                        }
                        // --- END OF STEP 3 FALLBACK ---
                    }

                    // Update the meal in the plan and the signature in our tracking set
                    out.days[dIdx].meals[mIdx] = meal
                    let newSig = mealSignature(meal)
                    var set = seen[key] ?? Set()
                    set.insert(newSig)
                    seen[key] = set
                }
            }

            let polished = await diversifyDescriptiveTitlesIfNeeded(plan: out, onLog: onLog)
            onLog?("✅ Inter-day variety pass complete.")
            return polished
        }
}

