        // New Helper 2: Takes variant ideas, validates them against the database, and returns the best available matches.
    @MainActor
    private func validateAndSelectBestVariants(
        variantIdeas: [String],
        baseFood: String,
        count: Int,
        onLog: (@Sendable (String) -> Void)?
    ) async -> [String] {
        guard !variantIdeas.isEmpty else { return [] }
        let search = SmartFoodSearch(container: self.container)
        var validatedVariants: [String] = []
        
        for idea in variantIdeas {
            // First, try to find an exact match in the database. This is the highest quality result.
            if let existing = try? ModelContext(self.container).fetch(FetchDescriptor<FoodItem>(predicate: #Predicate { $0.name == idea })).first {
                validatedVariants.append(existing.name)
                onLog?("    - ✅ Validated variant by exact match: '\(existing.name)'")
                continue
            }
            
            // If no exact match, perform a smart search, using the base food as context and a required headword.
            let tokenizedWords = FoodItem.makeTokens(from: baseFood)
            let ids = await search.searchFoodsAI(
                query: idea,
                limit: 5,
                context: "Validating variants for \(baseFood)",
                requiredHeadwords: tokenizedWords
            )
            
            if let bestCandidateID = ids.first, let foodItem = fetchFoodItem(by: bestCandidateID) {
                validatedVariants.append(foodItem.name)
                onLog?("    - ✅ Validated variant by smart search: '\(idea)' -> '\(foodItem.name)'")
            } else {
                onLog?("    - ⚠️ Could not validate variant idea '\(idea)' against the database. It will be created if needed.")
                // If we can't find it, we can still use the AI's idea. The creation step will handle it.
                validatedVariants.append(idea)
            }
        }
        
        // Ensure we have unique variants, prioritizing the validated ones.
        var finalSelection: [String] = []
        var seen = Set<String>()
        for variant in validatedVariants {
            if seen.insert(variant.lowercased()).inserted {
                finalSelection.append(variant)
            }
        }
        
        return Array(finalSelection.prefix(count))
    }
    
    @MainActor
    private func aiGenerateVariants(
        for baseDish: String,
        count: Int,
        mealName: String?,
        excludedFoods: [String],
        onLog: (@Sendable (String) -> Void)?
    ) async -> [String] {
        let cleanCount = max(1, min(count, 7))
        let exclusions = excludedFoods.isEmpty ? "none" : excludedFoods.joined(separator: ", ")
        let meal = mealName ?? "Meal"

        let instructions = Instructions {
            """
            You are a culinary planner. Generate realistic, distinct variants of a base dish for a specific meal across different days.
            Rules:
            - Output exactly N full dish names (no bullets, no numbering, no extra prose).
            - Variants must be plausible and diverse (change method, cut, garnish OR style), not just repeat the same words.
            - Respect exclusions/banned ingredients.
            - Avoid returning the base dish name unchanged.
            - Keep names concise; avoid listing long topping lists.
            """
        }

        let session = LanguageModelSession(instructions: instructions)
        let prompt = """
        BASE DISH: \(baseDish)
        MEAL: \(meal)
        EXCLUDED INGREDIENTS: \(exclusions)
        N: \(cleanCount)

        Respond with exactly N variant names as an array according to the provided schema.
        """

        do {
            let resp = try await session.respond(
                to: prompt,
                generating: AIVariantListResponse.self,
                includeSchemaInPrompt: true,
                options: GenerationOptions(sampling: .greedy)
            ).content

            // 1) Normalize & dedupe strictly
            func normalize(_ s: String) -> String {
                return s
                    .trimmingCharacters(in: .whitespacesAndNewlines)
                    .replacingOccurrences(of: "[\n\t]+", with: " ", options: .regularExpression)
            }
            let baseNorm = baseDish.lowercased().trimmingCharacters(in: .whitespacesAndNewlines)
            var uniq: [String] = []
            var seen = Set<String>()
            for v in resp.variants {
                let k = normalize(v)
                guard !k.isEmpty else { continue }
                let lc = k.lowercased()
                // reject exact base duplicates
                if lc == baseNorm { continue }
                if seen.insert(lc).inserted { uniq.append(k) }
            }

            // 2) If the model under-delivered, synthesize generic variants WITHOUT hardcoded foods
            if uniq.count < cleanCount {
                // Generic, cuisine-agnostic modifiers
                let methods = ["grilled","baked","roasted","steamed","pan-seared","air-fried","poached"]
                let cutsOrForms = ["slices","cubes","fillet","strips","whole","chips","roast"]
                let lightAdds = ["with herbs","with vegetables","with yogurt","with cheese","with tomato","with greens","with spices"]

                var i = 0
                while uniq.count < cleanCount && i < 40 { // cap to avoid infinite loop
                    let method = methods[i % methods.count]
                    let form = cutsOrForms[(i / methods.count) % cutsOrForms.count]
                    let add = lightAdds[(i / (methods.count * cutsOrForms.count)) % lightAdds.count]
                    let candidate = "\(baseDish) (\(method) \(form)) \(add)"
                    let lc = candidate.lowercased()
                    if lc != baseNorm && !seen.contains(lc) {
                        uniq.append(candidate)
                        seen.insert(lc)
                    }
                    i += 1
                }
            }

            // 3) Final guard: pad with numbered variants as a last resort (still non-identical strings)
            if uniq.count < cleanCount {
                var padded = uniq
                while padded.count < cleanCount {
                    let candidate = "\(baseDish) (variant \(padded.count + 1))"
                    if !seen.contains(candidate.lowercased()) {
                        padded.append(candidate)
                        seen.insert(candidate.lowercased())
                    }
                }
                onLog?("    - Not enough distinct AI variants for '\(baseDish)'. Added generic placeholders.")
                return padded
            }

            return Array(uniq.prefix(cleanCount))
        } catch {
            onLog?("    - ⚠️ Variant generation failed for \(baseDish): \(error.localizedDescription). Using generic labels.")
            return (0..<cleanCount).map { "\(baseDish) (variant \($0+1))" }
        }
    }

    // Нормализира имената на храненията към заявената структура (Breakfast/Lunch/Dinner),
    // като премества творческото наименование в descriptiveTitle.
    private func normalizeMealsToRequestedOrder(
        plan: AIConceptualPlanResponse,
        daysAndMeals: [Int: [String]],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        var newPlan = plan
        for dIdx in 0..<newPlan.days.count {
            let dayNumber = newPlan.days[dIdx].day
            guard let requested = daysAndMeals[dayNumber], !requested.isEmpty else { continue }
            let currentMeals = newPlan.days[dIdx].meals
            var normalized: [ConceptualMeal] = []
            for (i, reqName) in requested.enumerated() {
                if i < currentMeals.count {
                    var m = currentMeals[i]
                    if m.name.caseInsensitiveCompare(reqName) != .orderedSame {
                        let newTitle = m.descriptiveTitle.isEmpty ? m.name : m.descriptiveTitle
                        m = ConceptualMeal(name: reqName, descriptiveTitle: newTitle, components: m.components)
                    }
                    normalized.append(m)
                } else {
                    normalized.append(ConceptualMeal(name: reqName, descriptiveTitle: reqName, components: []))
                }
            }
            newPlan.days[dIdx].meals = normalized
        }
        onLog?("✅ Normalized meal names to requested structure (Breakfast/Lunch/Dinner).")
        return newPlan
    }

    // Правила "must contain …" + парсване от нашите структурни низове
    private struct MustContainRule: Equatable { // <-- Add this conformance
            let day: Int
            let meal: String? // ако е nil → „one meal“
            let topic: String
        }

    private func parseMustContainRules(_ requests: [String]) -> [MustContainRule] {
        var rules: [MustContainRule] = []
        let rx1 = try! NSRegularExpression(pattern: #"On Day (\d+), the ([A-Za-z]+) meal must contain ([^\.]+)\."#)
        let rx2 = try! NSRegularExpression(pattern: #"On Day (\d+), one meal must contain ([^\.]+)\."#)
        for s in requests {
            if let m = rx1.firstMatch(in: s, range: NSRange(s.startIndex..., in: s)) {
                let day = Int((s as NSString).substring(with: m.range(at: 1))) ?? 0
                let meal = (s as NSString).substring(with: m.range(at: 2))
                let topic = (s as NSString).substring(with: m.range(at: 3))
                rules.append(.init(day: day, meal: meal, topic: topic))
            } else if let m = rx2.firstMatch(in: s, range: NSRange(s.startIndex..., in: s)) {
                let day = Int((s as NSString).substring(with: m.range(at: 1))) ?? 0
                let topic = (s as NSString).substring(with: m.range(at: 2))
                rules.append(.init(day: day, meal: nil, topic: topic))
            }
        }
        return rules
    }

    private func mealContainsTopic(_ meal: ConceptualMeal, topic: String) -> Bool {
        meal.components.contains { $0.name.range(of: topic, options: .caseInsensitive) != nil }
    }

    // UPDATED: This function is now smarter. Instead of just adding a food, it will try to replace an existing protein source.
    private func enforceMustContain(
        plan: AIConceptualPlanResponse,
        rules: [MustContainRule],
        excludedFoods: [String],
        defaultGrams: Double = 120,
        onLog: (@Sendable (String) -> Void)?
    ) async -> AIConceptualPlanResponse {
        guard !rules.isEmpty else { return plan }
        var newPlan = plan
        let excludedSet = excludedFoods.map { $0.lowercased() }

        func isProtein(_ n: String) -> Bool {
            ["chicken","pork","beef","turkey","salmon","tuna","fish","lamb","loin","breast","steak","ham","shrimp","egg","tofu","tempeh","lentil","bean"].contains { n.lowercased().contains($0) }
        }

        for rule in rules {
            let topicLower = rule.topic.lowercased()
            if excludedSet.contains(where: { topicLower.contains($0) }) {
                onLog?("    - Skipping rule for '\(rule.topic)' because it conflicts with exclusions.")
                continue
            }
            if await !isConcreteFoodName(rule.topic) {
                onLog?("    - Skipping rule for non-concrete topic '\(rule.topic)'.")
                continue
            }

            guard let dIdx = newPlan.days.firstIndex(where: { $0.day == rule.day }) else { continue }

            if let mealName = rule.meal {
                if let mIdx = newPlan.days[dIdx].meals.firstIndex(where: { $0.name.caseInsensitiveCompare(mealName) == .orderedSame }) {
                    if !mealContainsTopic(newPlan.days[dIdx].meals[mIdx], topic: rule.topic) {
                        if let existingProteinIdx = newPlan.days[dIdx].meals[mIdx].components.firstIndex(where: { isProtein($0.name) }) {
                            let oldProteinName = newPlan.days[dIdx].meals[mIdx].components[existingProteinIdx].name
                            newPlan.days[dIdx].meals[mIdx].components[existingProteinIdx] = .init(name: rule.topic.capitalized, grams: defaultGrams)
                            onLog?("✅ Enforced: Day \(rule.day) '\(mealName)' now contains \(rule.topic) (replaced '\(oldProteinName)').")
                        } else {
                            newPlan.days[dIdx].meals[mIdx].components.append(.init(name: rule.topic.capitalized, grams: defaultGrams))
                            onLog?("✅ Enforced: Day \(rule.day) '\(mealName)' now contains \(rule.topic) (added).")
                        }
                    }
                }
            } else {
                let alreadyHas = newPlan.days[dIdx].meals.contains { mealContainsTopic($0, topic: rule.topic) }
                if !alreadyHas, let mIdx = newPlan.days[dIdx].meals.indices.first {
                    if let existingProteinIdx = newPlan.days[dIdx].meals[mIdx].components.firstIndex(where: { isProtein($0.name) }) {
                        let oldProteinName = newPlan.days[dIdx].meals[mIdx].components[existingProteinIdx].name
                        newPlan.days[dIdx].meals[mIdx].components[existingProteinIdx] = .init(name: rule.topic.capitalized, grams: defaultGrams)
                        onLog?("✅ Enforced: Day \(rule.day) now has \(rule.topic) in '\(newPlan.days[dIdx].meals[mIdx].name)' (replaced '\(oldProteinName)').")
                    } else {
                        newPlan.days[dIdx].meals[mIdx].components.append(.init(name: rule.topic.capitalized, grams: defaultGrams))
                        onLog?("✅ Enforced: Day \(rule.day) now has \(rule.topic) in '\(newPlan.days[dIdx].meals[mIdx].name)' (added).")
                    }
                }
            }
        }
        return newPlan
    }

    // Ensures dinners across days use different primary proteins, unless a Dinner has a specific must-contain rule (e.g., chicken on Day 1 Dinner).
    private func diversifyDinnerProteins(
        plan: AIConceptualPlanResponse,
        daysAndMeals: [Int: [String]],
        mustContainRules: [MustContainRule],
        excludedFoods: [String],
        foodPalette: [String],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        var newPlan = plan

        // Map of day -> locked dinner protein (from must-contain rules), e.g., [1: "chicken"]
        var lockedDinnerProtein: [Int: String] = [:]
        for r in mustContainRules {
            if let meal = r.meal, meal.caseInsensitiveCompare("Dinner") == .orderedSame {
                lockedDinnerProtein[r.day] = r.topic.lowercased()
            }
        }

        let excludedSet: Set<String> = Set(excludedFoods.map { $0.lowercased() })

        func isProteinCandidate(_ name: String) -> Bool {
            let keys = ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","egg","eggs","tofu","tempeh","lentil","lentils","bean","beans"]
            let lower = name.lowercased()
            return keys.contains { lower.contains($0) }
        }
        func coreProteinKey(_ name: String) -> String {
            let keys = ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","egg","tofu","tempeh","lentil","bean"]
            let lower = name.lowercased()
            for k in keys { if lower.contains(k) { return k } }
            return lower
        }

        // Build a list of alternative protein candidates (prefer palette items), filtered by excludes
        var candidates: [String] = []
        for item in foodPalette {
            let lower = item.lowercased()
            if isProteinCandidate(lower) {
                let key = coreProteinKey(lower)
                if !excludedSet.contains(key) { candidates.append(item) }
            }
        }
        // Dynamic fallback: mine DB for protein-like dishes (no hardcoded foods)
        if candidates.count < 8 {
            let ctx = ModelContext(self.container)
            let descriptor = FetchDescriptor<FoodItem>()
            if let all = try? ctx.fetch(descriptor) {
                var mined: [String] = []
                for f in all {
                    let n = f.name
                    if isProteinCandidate(n) && !excludedSet.contains(coreProteinKey(n)) {
                        mined.append(n)
                    }
                }
                var seen2 = Set(candidates.map { $0.lowercased() })
                for m in mined {
                    let lm = m.lowercased()
                    if !seen2.contains(lm) { candidates.append(m); seen2.insert(lm) }
                }
            }
        }
        // Deduplicate while preserving order
        var seen = Set<String>()
        candidates = candidates.filter { let k = $0.lowercased(); defer { seen.insert(k) }; return !seen.contains(k) }

        // Track which core proteins we already used for dinners (excluding locked days)
        var usedDinnerProteins = Set<String>()

        // Iterate by actual day order
        let orderedDays = newPlan.days.sorted(by: { $0.day < $1.day })
        for (idx, day) in orderedDays.enumerated() {
            guard let planDayIndex = newPlan.days.firstIndex(where: { $0.day == day.day }) else { continue }

            // Locate the Dinner meal by normalized name
            guard let dinnerIndex = newPlan.days[planDayIndex].meals.firstIndex(where: { $0.name.caseInsensitiveCompare("Dinner") == .orderedSame }) else { continue }

            // Find primary protein component (first protein-like component)
            guard let proteinCompIndex = newPlan.days[planDayIndex].meals[dinnerIndex].components.firstIndex(where: { isProteinCandidate($0.name) }) else { continue }
            let currentName = newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].name
            let currentKey = coreProteinKey(currentName)

            // If Dinner is locked to a specific protein by rule, keep it as-is
            if let locked = lockedDinnerProtein[day.day] {
                if currentKey != coreProteinKey(locked) {
                    // If somehow it doesn't match, enforce the locked topic here as a safety net
                    let grams = newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].grams
                    newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].name = locked.capitalized
                    newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].grams = grams
                    onLog?("✅ Dinner lock enforced again on Day \(day.day): \(locked)")
                }
                usedDinnerProteins.insert(coreProteinKey(locked))
                continue
            }

            // If not locked and we already used this protein on a previous (unlocked) dinner, swap it
            if usedDinnerProteins.contains(currentKey) {
                if let replacement = candidates.first(where: { cand in
                    let key = coreProteinKey(cand)
                    return key != currentKey && !usedDinnerProteins.contains(key) && !excludedSet.contains(key)
                }) {
                    let grams = newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].grams
                    newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].name = replacement
                    newPlan.days[planDayIndex].meals[dinnerIndex].components[proteinCompIndex].grams = grams
                    usedDinnerProteins.insert(coreProteinKey(replacement))
                    onLog?("✅ Diversified Dinner on Day \(day.day): replaced '\(currentName)' with '\(replacement)'.")
                    // 🌿 Occasionally add a salad or fruit if not present (about every 2–3 days)
                    if day.day % 2 == 0 {
                        let saladOptions = ["Mixed green salad", "Greek salad", "Tomato and cucumber salad"]
                        let fruitOptions = ["Apple slices", "Orange segments", "Mixed berries", "Fruit salad"]
                        let addSalad = Bool.random()
                        let addition = addSalad ? saladOptions.randomElement()! : fruitOptions.randomElement()!
                        newPlan.days[planDayIndex].meals[dinnerIndex].components.append(
                            .init(name: addition, grams: addSalad ? 120 : 100)
                        )
                        onLog?("🥗 Added \(addSalad ? "salad" : "fruit") to Dinner on Day \(day.day): \(addition)")                    }

                    // 🥘 Ensure the meal doesn’t have more than one main course
                    var proteinCount = 0
                    newPlan.days[planDayIndex].meals[dinnerIndex].components.removeAll {
                        let isProt = isProteinCandidate($0.name)
                        if isProt {
                            proteinCount += 1
                            return proteinCount > 1 // keep only the first main course
                        }
                        return false
                    }

                } else {
                    onLog?("ℹ️ No suitable alternative protein found to diversify Dinner on Day \(day.day). Keeping '\(currentName)'.")
                }
            } else {
                // First time we see this protein key on an unlocked dinner
                usedDinnerProteins.insert(currentKey)
            }
        }

        onLog?("✅ Diversified dinner proteins across days (respecting must-contain & excludes).")
        return newPlan
    }

    // Ensures each meal has at most one main-course protein by replacing extras with light sides (salads/fruits/veg) when possible.
    private func enforceSingleMainCourse(
        plan: AIConceptualPlanResponse,
        excludedFoods: [String],
        foodPalette: [String],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        var newPlan = plan
        let excludedSet = Set(excludedFoods.map { $0.lowercased() })

        func isProtein(_ n: String) -> Bool {
            let keys = ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","egg","eggs","tofu","tempeh","lentil","lentils","bean","beans"]
            let l = n.lowercased(); return keys.contains { l.contains($0) }
        }
        func isFruit(_ n: String) -> Bool { n.lowercased().contains("fruit") }
        func isSalad(_ n: String) -> Bool {
            let l = n.lowercased(); return l.contains("salad") || l.contains("greens")
        }
        func violatesExcluded(_ n: String) -> Bool {
            let l = n.lowercased(); return excludedSet.contains { l.contains($0) }
        }

        // Build side candidates: prefer salads/fruits from palette, then dynamic fallback
        var sideCandidates: [String] = []
        for item in foodPalette {
            let l = item.lowercased()
            if (isSalad(l) || isFruit(l)) && !violatesExcluded(l) { sideCandidates.append(item) }
        }
        if sideCandidates.isEmpty {
            let ctx = ModelContext(self.container)
            let descriptor = FetchDescriptor<FoodItem>()
            if let all = try? ctx.fetch(descriptor) {
                var mined: [String] = []
                for f in all {
                    let l = f.name.lowercased()
                    if (l.contains("salad") || l.contains("fruit")) && !violatesExcluded(l) {
                        mined.append(f.name)
                    }
                }
                var seenM = Set(sideCandidates.map { $0.lowercased() })
                for m in mined {
                    let lm = m.lowercased()
                    if !seenM.contains(lm) { sideCandidates.append(m); seenM.insert(lm) }
                }
            }
        }
        // Deduplicate preserving order
        var seen = Set<String>()
        sideCandidates = sideCandidates.filter { let k = $0.lowercased(); defer { seen.insert(k) }; return !seen.contains(k) }

        for d in 0..<newPlan.days.count {
            for m in 0..<newPlan.days[d].meals.count {
                let comps = newPlan.days[d].meals[m].components
                var proteinIdxs: [Int] = []
                for (i,c) in comps.enumerated() { if isProtein(c.name) { proteinIdxs.append(i) } }
                guard proteinIdxs.count > 1 else { continue }

                // Keep the first protein, replace the rest with light sides
                for extraIdx in proteinIdxs.dropFirst() {
                    if let replacement = sideCandidates.first {
                        let grams = newPlan.days[d].meals[m].components[extraIdx].grams
                        let targetGrams = max(80.0, min(grams, isFruit(replacement) ? 150.0 : 130.0))
                        newPlan.days[d].meals[m].components[extraIdx].name = replacement
                        newPlan.days[d].meals[m].components[extraIdx].grams = targetGrams
                        onLog?("✅ Enforced single main course in \(newPlan.days[d].meals[m].name): replaced extra protein with '\(replacement)'.")
                    } else {
                        // No sides available; at least shrink it so it’s clearly not a main
                        newPlan.days[d].meals[m].components[extraIdx].grams = 60.0
                        onLog?("ℹ️ No side candidates available; downsized extra protein in \(newPlan.days[d].meals[m].name).")
                    }
                }
            }
        }
        return newPlan
    }

    // Ensures at least one salad or fruit appears per day. Adds to Lunch if absent, respecting component count and excludes.
    private func sprinkleSaladsAndFruits(
        plan: AIConceptualPlanResponse,
        excludedFoods: [String],
        foodPalette: [String],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        var newPlan = plan
        let excludedSet = Set(excludedFoods.map { $0.lowercased() })

        func isFruit(_ n: String) -> Bool { n.lowercased().contains("fruit") }
        func isSalad(_ n: String) -> Bool {
            let l = n.lowercased(); return l.contains("salad") || l.contains("greens")
        }
        func violatesExcluded(_ n: String) -> Bool {
            let l = n.lowercased(); return excludedSet.contains { l.contains($0) }
        }
        func mealHasSaladOrFruit(_ meal: ConceptualMeal) -> Bool {
            meal.components.contains { isFruit($0.name) || isSalad($0.name) }
        }

        // Build candidates
        var candidates: [String] = []
        for item in foodPalette { let l = item.lowercased(); if (isSalad(l) || isFruit(l)) && !violatesExcluded(l) { candidates.append(item) } }
        if candidates.isEmpty {
            let ctx = ModelContext(self.container)
            let descriptor = FetchDescriptor<FoodItem>()
            if let all = try? ctx.fetch(descriptor) {
                var mined: [String] = []
                for f in all {
                    let l = f.name.lowercased()
                    if (l.contains("salad") || l.contains("fruit")) && !violatesExcluded(l) {
                        mined.append(f.name)
                    }
                }
                var seenM = Set(candidates.map { $0.lowercased() })
                for m in mined {
                    let lm = m.lowercased()
                    if !seenM.contains(lm) { candidates.append(m); seenM.insert(lm) }
                }
            }
        }
        var seen2 = Set<String>(); candidates = candidates.filter { let k = $0.lowercased(); defer { seen2.insert(k) }; return !seen2.contains(k) }

        for d in 0..<newPlan.days.count {
            // Already has salad/fruit this day?
            let dayHas = newPlan.days[d].meals.contains(where: mealHasSaladOrFruit)
            if dayHas { continue }

            // Prefer Lunch; otherwise first meal present
            let lunchIdx = newPlan.days[d].meals.firstIndex { $0.name.caseInsensitiveCompare("Lunch") == .orderedSame }
            let targetMealIdx = lunchIdx ?? 0
            guard newPlan.days[d].meals.indices.contains(targetMealIdx), let pick = candidates.first else { continue }

            if newPlan.days[d].meals[targetMealIdx].components.count < 4 {
                newPlan.days[d].meals[targetMealIdx].components.append(.init(name: pick, grams: isFruit(pick) ? 150.0 : 120.0))
                onLog?("✅ Sprinkled \(pick) into Day \(newPlan.days[d].day) \(newPlan.days[d].meals[targetMealIdx].name).")
            } else {
                // Replace the last non-protein
                if let replaceIdx = newPlan.days[d].meals[targetMealIdx].components.lastIndex(where: { c in
                    let n = c.name.lowercased()
                    let proteinKeys = ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","egg","eggs","tofu","tempeh","lentil","bean","beans"]
                    return !proteinKeys.contains { n.contains($0) }
                }) {
                    newPlan.days[d].meals[targetMealIdx].components[replaceIdx] = .init(name: pick, grams: isFruit(pick) ? 150.0 : 120.0)
                    onLog?("✅ Replaced a side with \(pick) in Day \(newPlan.days[d].day) \(newPlan.days[d].meals[targetMealIdx].name) to include salad/fruit.")
                }
            }
        }
        return newPlan
    }

    @MainActor
    private func isGenericTitle(_ s: String) -> Bool {
        let l = s.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        if l.isEmpty { return true }
        let genericTokens = ["morning", "evening", "balanced", "wellness", "start", "meal", "hearty", "comforting", "light", "nutritious"]
        return genericTokens.contains { l.contains($0) }
    }

    @MainActor
    private func aiPolishTitle(for meal: ConceptualMeal, day: Int, onLog: (@Sendable (String) -> Void)?) async -> String? {
        let items = meal.components.map { "\($0.name) (\(Int($0.grams))g)" }.joined(separator: ", ")
        let prompt = """
        You are assisting in a meal plan UI. Rewrite the descriptive title for a \(meal.name) so it is concise (max ~6 words), specific, and cuisine-aware, based on its components.
        Avoid generic words like “morning”, “evening”, “balanced”, “start”, “meal”, “wellness”.
        Keep it natural and non-marketing. Do not include quantities.

        MEAL: \(meal.name)
        COMPONENTS: \(items)
        CURRENT TITLE: \(meal.descriptiveTitle.ifEmpty("n/a"))

        Respond with a single improved title string.
        """
        do {
            let session = LanguageModelSession()
            let resp = try await session.respond(to: prompt, options: GenerationOptions(sampling: .greedy))
            let out = resp.content.trimmingCharacters(in: CharacterSet.whitespacesAndNewlines)
            guard !out.isEmpty, out.count <= 60 else { return nil }
            onLog?("🖋️ Polished title for Day \(day) • \(meal.name): '\(meal.descriptiveTitle)' → '\(out)'")
            return out
        } catch {
            onLog?("   - Title polish skipped (\(error.localizedDescription)).")
            return nil
        }
    }

    @MainActor
    private func diversifyDescriptiveTitlesIfNeeded(plan: AIConceptualPlanResponse, onLog: (@Sendable (String) -> Void)?) async -> AIConceptualPlanResponse {
        var out = plan
        for d in 0..<out.days.count {
            for m in 0..<out.days[d].meals.count {
                let t = out.days[d].meals[m].descriptiveTitle
                if isGenericTitle(t) {
                    if let newT = await aiPolishTitle(for: out.days[d].meals[m], day: out.days[d].day, onLog: onLog) {
                        let old = out.days[d].meals[m]
                        out.days[d].meals[m] = ConceptualMeal(name: old.name, descriptiveTitle: newT, components: old.components)
                    }
                }
            }
        }
        return out
    }

    private func filterCandidates(_ candidates: [FoodItem], banned: [String]) -> [FoodItem] {
        guard !candidates.isEmpty else { return [] }
        let dynamicBans = banned.map { $0.lowercased() }
        // Extra hard bans to avoid clearly wrong categories while minimizing false positives
        let hardBans = [
            "baby food","infant","toddler","gerber",
            "stage 1","stage 2","stage 3",
            "steelhead",
            "dog food","cat food","pet food"
        ]
        let allBans = Set(dynamicBans + hardBans)
        return candidates.filter { f in
            let name = f.name.lowercased()
            return !allBans.contains { name.contains($0) }
        }
    }

