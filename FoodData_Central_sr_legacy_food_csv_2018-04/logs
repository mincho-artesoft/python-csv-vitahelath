    // Candidate filter with dynamic + hard bans
    private func filterCandidates(
        _ candidates: [FoodItemCandidate],
        banned: [String],
        originalName: String,
        originalCategory: String,
        recipeContext: RecipeContextProfile
    ) -> [FoodItemCandidate] {
        emitLog("filterCandidates – START (\(candidates.count) incoming, \(banned.count) banned tokens)", onLog: nil)
        guard !candidates.isEmpty else {
            emitLog("filterCandidates – END (empty candidates)", onLog: nil)
            return []
        }

        let dynamicBans = banned.map { $0.lowercased() }
        let hardBans = [
            "baby food","infant","toddler","gerber",
            "stage 1","stage 2","stage 3",
            "dog food","cat food","pet food"
        ]
        let allBans = Set(dynamicBans + hardBans)
        
        let baseLikeCategories: Set<String> = [
          "vegetable","fruit","meat","dairy","spice","herb","grain","legume","oil","condiment","egg","eggs"
        ]
        let compositeNoiseTokens: [String] = [
          "dip","spread","sauce","marinade","seasoning","mix","burger","burgundy",
          "pie","cake","bread","sandwich","salad","casserole","chili","stew","soup",
          "ready-to-eat","frozen meal","entrée"
        ]
        let originalLower = originalName.lowercased()
        let catLower = originalCategory.lowercased()
        let isBase = baseLikeCategories.contains(catLower)
        // If the target isn’t itself a sauce/condiment, avoid obviously composite prepared-food names.
        let shouldAvoidComposites = isBase && !(originalLower.contains("sauce") || catLower == "condiment")

        let out = candidates.filter { c in
            let name = c.name.lowercased()
            // dynamic & hard bans:
            if allBans.contains(where: { token in name.contains(token) }) { return false }

            // extra safety: in no-cook contexts, block cooked/heat methods that slipped through
            if recipeContext.disallowCookedForms,
               ["cooked","boiled","grilled","roasted","fried","baked","steamed","sautéed","sauteed",
                "toasted","broiled","poached","braised","simmered","stewed","air fried","air-fried"]
                .contains(where: { name.contains($0) }) {
                return false
            }

            // block composite dish words for base ingredients (prevents: “Eggplant dip”, “Beef burgundy”, “Bread, onion/egg”)
            if shouldAvoidComposites,
               compositeNoiseTokens.contains(where: { token in name.contains(token) }) {
                return false
            }
            return true
        }

        emitLog("filterCandidates – END (kept \(out.count) / \(candidates.count))", onLog: nil)
        return out
    }
    
    private nonisolated static func canonicalHeadTokens(_ s: String) -> Set<String> {
        let raw = SmartFoodSearch.tokenize(s).map { $0.lowercased() }
        let stateStopwords: Set<String> = [
            "raw","fresh","ripe","unripe","peeled","unpeeled","whole","chopped","minced","sliced",
            "cooked","boiled","grilled","roasted","fried","baked","steamed","sauteed","sautéed",
            "toasted","broiled","poached","braised","simmered","stewed","air","air-fried","airfried"
        ]
        return Set(raw.filter { t in
            return !Self._prepStopwords.contains(t)
                && !stateStopwords.contains(t)
                && !Self._overqualifyingNouns.contains(t)
                && !t.isEmpty
        })
    }

    private nonisolated static func isCandidateSuitableName(_ candidateName: String, originalName: String) -> Bool {
        let o = Self.canonicalHeadTokens(originalName)
        let c = Self.canonicalHeadTokens(candidateName)
        guard !o.isEmpty, !c.isEmpty else { return false }
        let inter = o.intersection(c).count
        let unionCount = o.union(c).count
        let jaccard = Double(inter) / Double(unionCount)
        return inter >= 1 && jaccard >= 0.34
    }
  
}

import SwiftData
