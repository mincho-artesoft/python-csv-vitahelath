    private func trimToRequestedDaysAndMeals(
        plan: AIConceptualPlanResponse,
        daysAndMeals: [Int: [String]],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        var out = plan
        let wantedDays = Set(daysAndMeals.keys)
        out.days.removeAll { !wantedDays.contains($0.day) }
        for i in 0..<out.days.count {
            let day = out.days[i].day
            let wantedMeals = daysAndMeals[day] ?? []
            out.days[i].meals = out.days[i].meals
                .filter { m in wantedMeals.contains { $0.caseInsensitiveCompare(m.name) == .orderedSame } }
                .sorted { a, b in
                    let ia = wantedMeals.firstIndex { $0.caseInsensitiveCompare(a.name) == .orderedSame } ?? .max
                    let ib = wantedMeals.firstIndex { $0.caseInsensitiveCompare(b.name) == .orderedSame } ?? .max
                    return ia < ib
                }
        }
        onLog?("✅ Normalized to requested days/meals: kept days \(out.days.map{ $0.day }).")
        return out
    }
    
    private func purgeExcludedFoods(
        plan: AIConceptualPlanResponse,
        excludedFoods: [String],
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        guard !excludedFoods.isEmpty else { return plan }
        var out = plan
        let banned = excludedFoods.map { $0.lowercased() }
        for d in 0..<out.days.count {
            for m in 0..<out.days[d].meals.count {
                let before = out.days[d].meals[m].components.count
                out.days[d].meals[m].components.removeAll { c in
                    banned.contains { c.name.lowercased().contains($0) }
                }
                let after = out.days[d].meals[m].components.count
                if after < before {
                    onLog?("    - Removed \(before - after) banned component(s) from Day \(out.days[d].day) • \(out.days[d].meals[m].name).")
                }
                if out.days[d].meals[m].components.isEmpty {
                    out.days[d].meals[m].components = [ConceptualComponent(name: "Mixed Greens", grams: 80)]
                }
            }
        }
        return out
    }
    
    private func clampPortionsHeuristically(
        plan: AIConceptualPlanResponse,
        profile: Profile,
        onLog: (@Sendable (String) -> Void)?
    ) -> AIConceptualPlanResponse {
        func clamp(_ x: Double, _ lo: Double, _ hi: Double) -> Double { max(lo, min(hi, x)) }
        func round5(_ x: Double) -> Double { (x / 5.0).rounded() * 5.0 }

        // Goal-driven biases
        let goal = profile.goal
        let (preferLower, preferHighProtein, preferHigherCarb): (Bool, Bool, Bool)
        switch goal {
        case .weightLoss?:
            (preferLower, preferHighProtein, preferHigherCarb) = (true, false, false)
        case .muscleGain?, .strength?, .injuryRecovery?:
            (preferLower, preferHighProtein, preferHigherCarb) = (false, true, false)
        case .endurance?, .sportPerformance?:
            (preferLower, preferHighProtein, preferHigherCarb) = (false, false, true)
        default:
            (preferLower, preferHighProtein, preferHigherCarb) = (false, false, false)
        }

        // Category helpers
        func has(_ n: String, _ keys: [String]) -> Bool {
            let l = n.lowercased(); return keys.contains { l.contains($0) }
        }
        func isProtein(_ n: String) -> Bool {
            has(n, ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","loin","breast","steak","ham","egg","eggs","tofu","tempeh","lentil","lentils","bean","beans"])
        }
        func isStarchyVeg(_ n: String) -> Bool {
            has(n, ["potato","sweet potato","yuca","cassava","corn","peas"])
        }
        func isGrainOrBread(_ n: String) -> Bool {
            has(n, ["rice","quinoa","pasta","noodle","oat","oatmeal","bread","toast","couscous","bulgur","barley","tortilla","pita","wrap"])
        }
        func isDairyDrink(_ n: String) -> Bool {
            let l = n.lowercased()
            return (l.contains("milk") || l.contains("kefir") || l.contains("yogurt drink") || l.contains("smoothie")) && !l.contains("powder")
        }
        func isCheeseOrYogurt(_ n: String) -> Bool {
            has(n, ["cheese","mozzarella","cheddar","feta","ricotta","cottage","yogurt","yoghurt","skyr","quark"])
        }
        func isNutOrSeed(_ n: String) -> Bool {
            has(n, ["almond","walnut","hazelnut","peanut","pistachio","cashew","pecan","chia","flax","linseed","sunflower seed","pumpkin seed","sesame"])
        }
        func isFruit(_ n: String) -> Bool {
            has(n, ["apple","banana","orange","grape","grapes","kiwi","pear","berries","berry","blueberry","strawberry","raspberry","mango","pineapple","peach","plum","apricot","watermelon","melon","cherry"])
        }
        func isSalad(_ n: String) -> Bool {
            let l = n.lowercased(); return l.contains("salad") || l.contains("greens")
        }
        func isVeg(_ n: String) -> Bool {
            has(n, ["broccoli","spinach","tomato","cucumber","carrot","pepper","bell pepper","capsicum","zucchini","courgette","eggplant","aubergine","lettuce","arugula","rocket","cabbage","cauliflower","asparagus","mushroom","onion","leek"])
        }
        func isSoup(_ n: String) -> Bool {
            let l = n.lowercased(); return l.contains("soup") || l.contains("broth")
        }
        func isSweetenerOrCondiment(_ n: String) -> Bool {
            has(n, [
                "honey","sugar","brown sugar","maple","agave","syrup","molasses","jam","jelly","preserves",
                "ketchup","mustard","mayo","mayonnaise","aioli","dressing","sauce","pesto","butter","ghee","cream"
            ])
        }

        // Ranges (grams), tuned by profile goals
        let proteinMin = 90.0
        let proteinMax = preferHighProtein ? 220.0 : (preferLower ? 150.0 : 180.0)

        // Starchy (grains & starchy veg)
        let starchLo = preferLower ? 80.0 : 90.0
        let starchHi = preferHigherCarb ? 240.0 : (preferLower ? 150.0 : 180.0)

        // Non-starchy vegetables & salads
        let vegLo = preferLower ? 60.0 : 70.0
        let vegHi = preferLower ? 160.0 : 200.0
        let saladLo = 90.0
        let saladHi = 180.0

        // Fruit
        let fruitLo = preferLower ? 100.0 : 120.0
        let fruitHi = preferLower ? 160.0 : 180.0

        // Dairy solids (cheese/yogurt cup)
        let cheeseLo = preferLower ? 20.0 : 25.0
        let cheeseHi = preferLower ? 50.0 : 60.0

        // Drinks (milk/kefir/smoothie)
        let drinkLo = 200.0
        let drinkHi = 300.0

        // Nuts & seeds
        let nutsLo = preferLower ? 15.0 : 20.0
        let nutsHi = preferLower ? 30.0 : 40.0

        // Condiments / sugars / fats (keep tiny)
        let condLo = 5.0
        let condHi = preferLower ? 15.0 : 20.0

        // Soups
        let soupLo = 250.0
        let soupHi = 400.0

        var newPlan = plan
        var adjustedCount = 0

        for d in 0..<newPlan.days.count {
            for m in 0..<newPlan.days[d].meals.count {
                for c in 0..<newPlan.days[d].meals[m].components.count {
                    let name = newPlan.days[d].meals[m].components[c].name
                    var g = newPlan.days[d].meals[m].components[c].grams

                    let lower = name.lowercased()

                    if isSweetenerOrCondiment(lower) {
                        g = clamp(g, condLo, condHi)
                    } else if isProtein(lower) {
                        g = clamp(g, proteinMin, proteinMax)
                    } else if isGrainOrBread(lower) || isStarchyVeg(lower) {
                        g = clamp(g, starchLo, starchHi)
                    } else if isDairyDrink(lower) {
                        g = clamp(g, drinkLo, drinkHi)
                    } else if isCheeseOrYogurt(lower) {
                        g = clamp(g, cheeseLo, cheeseHi)
                    } else if isNutOrSeed(lower) {
                        g = clamp(g, nutsLo, nutsHi)
                    } else if isSoup(lower) {
                        g = clamp(g, soupLo, soupHi)
                    } else if isSalad(lower) {
                        g = clamp(g, saladLo, saladHi)
                    } else if isFruit(lower) {
                        g = clamp(g, fruitLo, fruitHi)
                    } else if isVeg(lower) { // non-starchy veg
                        g = clamp(g, vegLo, vegHi)
                    } else {
                        // generic fallback
                        g = clamp(g, preferLower ? 50.0 : 60.0, preferLower ? 180.0 : 200.0)
                    }

                    let newG = round5(g)
                    if newG != newPlan.days[d].meals[m].components[c].grams {
                        newPlan.days[d].meals[m].components[c].grams = newG
                        adjustedCount += 1
                    }
                }
            }
        }
        // Log-only guard: flag meals that look underbuilt after clamping
        for d in 0..<newPlan.days.count {
            for m in 0..<newPlan.days[d].meals.count {
                let comps = newPlan.days[d].meals[m].components
                if !comps.isEmpty && comps.allSatisfy({ $0.grams < 80.0 }) {
                    onLog?("⚠️ Meal '\(newPlan.days[d].meals[m].name)' on Day \(newPlan.days[d].day) may lack a main item (all components < 80 g).")
                }
            }
        }
        onLog?("✅ Applied advanced heuristic portion clamping (\(adjustedCount) component\(adjustedCount == 1 ? "" : "s") adjusted).")
        return newPlan
    }

    // MARK: - Smart query building for SmartFoodSearch

    @MainActor
     func aiBuildSmartQueries(
        for conceptName: String,
        mealContext: ConceptualMeal?,
        onLog: (@Sendable (String) -> Void)?
    ) async -> (queries: [String], banned: [String]) {
        // Early guard: for micro-ingredients use a minimal, safe query set and ban proteins
        let micro = conceptName.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        let microSet: Set<String> = [
            "salt","pepper","black pepper","cilantro","coriander","parsley","basil","oregano",
            "garlic","ginger","cumin","paprika","chili powder","cayenne","lemon","lime"
        ]
        if microSet.contains(micro) || (micro.hasSuffix("s") && microSet.contains(String(micro.dropLast()))) {
            let proteinBan = [
                "chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","ham",
                "egg","eggs","tofu","tempeh","lentil","lentils","bean","beans"
            ]
            // ⬇️ PREPEND conceptName отпред + печат (micro branch)
            var finalQueries: [String] = []
            let conceptTrimmed = conceptName.trimmingCharacters(in: .whitespacesAndNewlines)
            if !conceptTrimmed.isEmpty {
                finalQueries.append(conceptTrimmed)
            }
            if !finalQueries.contains(where: { $0.caseInsensitiveCompare(micro) == .orderedSame }) {
                finalQueries.append(micro)
            }
            onLog?("    - AI smart queries (concept first, micro): \(finalQueries) | banned: \(proteinBan)")
            return (finalQueries, proteinBan)
        }

        let baseBan = [
            "powder","dressing","sauce","oil","butter","flour","shake","mix","tots","paste",
            // Additional generic junky/sugary/ambiguous mappings to avoid for clean meal components
            "topping","toppings","candy","candies","bar","cookie","cookies","cake","pie","dessert",
            // Stronger disambiguation & jarred/infant foods
            "belly","steelhead","baby food","infant","toddler","gerber","stage 1","stage 2","stage 3"
        ]

        let instructions = Instructions {
            """
               RULES:
               - priorityKeywords: 2–4 lowercase tokens, ordered by importance.
                 * token[0] MUST be the headword (core ingredient).
                 * Prefer cuts/methods/dish-type terms (preparation or form), not marketing adjectives.
                 * No quantities, no stopwords, no cuisine adjectives.
               - bannedKeywords: tokens to exclude that indicate powders, sauces, dressings, shakes, or other non-solid/prepared forms.
               - headwordSynonyms: up to 3 lowercase synonyms for the headword that commonly appear in USDA-like names.
            """
        }
        let session = LanguageModelSession(instructions: instructions)

        // Контекстът на ястието помага моделът да предпочете подходящи токени (cut/method/тип)
        let other = mealContext.map { mc in
            mc.components
                .filter { $0.name.caseInsensitiveCompare(conceptName) != .orderedSame }
                .map(\.name)
                .joined(separator: ", ")
        } ?? ""

        let prompt = """
        Extract prioritized search tokens for a food concept so they match USDA-like food names.

        CONCEPT: "\(conceptName)"
        MEAL CONTEXT: \(mealContext?.name ?? "n/a") — \(mealContext?.descriptiveTitle ?? "n/a")
        OTHER COMPONENTS IN THIS MEAL: \(other.isEmpty ? "n/a" : other)
        """

        do {
            let resp = try await session.respond(
                to: prompt,
                generating: AISearchKeywordResponse.self,
                includeSchemaInPrompt: true,
                options: GenerationOptions(sampling: .greedy)
            ).content

            // Сглобяваме списък от заявки (от най-стриктна към по-широка)
            var queries: [String] = []
            let kw = resp.priorityKeywords
                .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
                .filter { !$0.isEmpty }

            if !kw.isEmpty {
                // до 3 токена: headword + най-важните модификатори
                let top3 = Array(kw.prefix(3))
                if top3.count >= 3 { queries.append(top3.joined(separator: " ")) }           // head + mod1 + mod2
                if top3.count >= 2 { queries.append(top3.prefix(2).joined(separator: " ")) } // head + mod1
                queries.append(String(top3[0]))                                              // само headword
            }

            // добавяме леки варианти със синоними
            if let head = kw.first, !resp.headwordSynonyms.isEmpty, kw.count >= 2 {
                let tail1 = kw[1]
                for syn in resp.headwordSynonyms.prefix(3) {
                    queries.append("\(syn) \(tail1)")
                    queries.append(syn)
                }
            }

            // Премахваме дубликати, пазим реда
            var seen = Set<String>()
            queries = queries.filter { seen.insert($0).inserted }

            // Бан лист
            var bannedSet = Set((resp.bannedKeywords + baseBan).map { $0.lowercased() })
            let cn = conceptName.lowercased()

            // Ако концептът е зелен/вегетарианска салата → бан протеин думи, за да избегнем "chicken salad" и т.н.
            if cn.contains("mixed green") || (cn.contains("salad") && !cn.contains("chicken") && !cn.contains("tuna") && !cn.contains("salmon") && !cn.contains("egg")) {
                ["chicken","turkey","salmon","tuna","fish","shrimp","pork","beef","lamb","ham"].forEach { bannedSet.insert($0) }
            }
            // Ако търсим лимон/резен → избягваме рибни отвличания
            if cn.contains("lemon wedge") || (cn.contains("lemon") && (cn.contains("wedge") || cn.contains("slice"))) {
                ["fish","salmon","cod","tuna"].forEach { bannedSet.insert($0) }
            }
            // Бери → избягваме десертни/топинг/сироп/конфитюр
            if cn.contains("berries") || cn.contains("berry") {
                ["topping","toppings","pie","syrup","jam","jelly","preserves","dessert"].forEach { bannedSet.insert($0) }
            }
            // Bell pepper → избягваме belly/pork belly false positives
            if cn.contains("bell pepper") {
                bannedSet.insert("belly")
                bannedSet.insert("pork belly")
            }
            // Steel-cut oats → избягваме steelhead trout
            if cn.contains("steel cut oat") || cn.contains("steel-cut oat") || cn.contains("steelcut oat") {
                ["steelhead","trout","fish"].forEach { bannedSet.insert($0) }
            }
            // Default adult guard
            if !cn.contains("baby ") {
                ["baby","infant","toddler","formula"].forEach { bannedSet.insert($0) }
            }

            let banned = Array(bannedSet)

            // ⬇️ PREPEND conceptName отпред + печат (успешен клон)
            var finalQueries = queries
            let conceptTrimmed = conceptName.trimmingCharacters(in: .whitespacesAndNewlines)
            if !conceptTrimmed.isEmpty {
                if let i = finalQueries.firstIndex(where: { $0.caseInsensitiveCompare(conceptTrimmed) == .orderedSame }) {
                    if i != 0 {
                        finalQueries.remove(at: i)
                        finalQueries.insert(conceptTrimmed, at: 0)
                    }
                } else {
                    finalQueries.insert(conceptTrimmed, at: 0)
                }
            }
            onLog?("    - AI smart queries (concept first): \(finalQueries) | banned: \(banned)")
            return (finalQueries, banned)

        } catch {
            onLog?("    - ⚠️ Keyword AI failed: \(error.localizedDescription). Using heuristic tokens.")

            // Хевристика: чистим стоп думи, оставяме headword + 1–2 модификатора
            let stop: Set<String> = ["of","with","and","or","in","on","for","a","an","the","style","fresh","raw","cooked","very","tasty"]
            let tokens = conceptName
                .lowercased()
                .replacingOccurrences(of: "[()\\[\\]{},:;./\\\\\\d]", with: " ", options: .regularExpression)
                .split(separator: " ")
                .map(String.init)
                .filter { !$0.isEmpty && !stop.contains($0) }

            var queries: [String] = []
            if !tokens.isEmpty {
                let head = tokens[0]
                let rest = Array(tokens.dropFirst())
                if rest.count >= 2 { queries.append([head, rest[0], rest[1]].joined(separator: " ")) }
                if rest.count >= 1 { queries.append([head, rest[0]].joined(separator: " ")) }
                queries.append(head)
            }

            // Дедуп с пазене на реда
            var seen = Set<String>()
            queries = queries.filter { seen.insert($0).inserted }

            // ⬇️ PREPEND conceptName отпред + печат (fallback)
            var finalQueries = queries
            let conceptTrimmed = conceptName.trimmingCharacters(in: .whitespacesAndNewlines)
            if !conceptTrimmed.isEmpty {
                if let i = finalQueries.firstIndex(where: { $0.caseInsensitiveCompare(conceptTrimmed) == .orderedSame }) {
                    if i != 0 {
                        finalQueries.remove(at: i)
                        finalQueries.insert(conceptTrimmed, at: 0)
                    }
                } else {
                    finalQueries.insert(conceptTrimmed, at: 0)
                }
            }
            onLog?("    - AI smart queries (concept first, fallback): \(finalQueries) | banned: \(baseBan)")
            return (finalQueries, baseBan)
        }
    }
    
